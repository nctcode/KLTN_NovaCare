{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novacare.local/research/dry-run-case-v0.1.schema.json",
  "title": "NovaCare Dry Run Case V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "templateFamilyId",
    "language",
    "synthetic",
    "demographics",
    "patientNarrative",
    "onsetDuration",
    "severity",
    "associatedSymptoms",
    "negatedSymptoms",
    "medicalHistory",
    "additionalAnswers"
  ],
  "properties": {
    "caseId": { "type": "string", "pattern": "^DR-[A-Z]{3}-[0-9]{3}$" },
    "templateFamilyId": { "type": "string", "pattern": "^DRF-[A-Z]{3}-[0-9]{2}$" },
    "language": { "const": "vi" },
    "synthetic": { "const": true },
    "demographics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age", "sex"],
      "properties": {
        "age": { "type": "integer", "minimum": 18, "maximum": 100 },
        "sex": { "enum": ["F", "M", "OTHER", "UNSPECIFIED"] }
      }
    },
    "patientNarrative": { "type": "string", "minLength": 1 },
    "onsetDuration": { "type": ["string", "null"] },
    "severity": { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
    "associatedSymptoms": { "type": "array", "items": { "type": "string" } },
    "negatedSymptoms": { "type": "array", "items": { "type": "string" } },
    "medicalHistory": { "type": "array", "items": { "type": "string" } },
    "additionalAnswers": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    }
  }
}
