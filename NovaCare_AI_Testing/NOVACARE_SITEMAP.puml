@startuml
title NovaCare - Sitemap tong quat

skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageFontStyle bold
skinparam ArrowColor black
skinparam RectangleBorderColor black
skinparam PackageBorderColor black

top to bottom direction

rectangle "NovaCare\nWeb System" as root

package "Public\n35 routes" as public
package "Authentication\n3 routes" as auth
package "Patient Dashboard\n10 routes" as patient
package "Platform Admin\n24 routes" as admin
package "Hospital Admin\n8 routes" as hospital

root --> public
root --> auth
root --> patient
root --> admin
root --> hospital

note right of root
  Frontend: 79 page routes
  Smart Screening is embedded
  in the booking flow.
end note

newpage
title NovaCare - Sitemap nguoi dung

skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 10

top to bottom direction

rectangle "NovaCare" as userRoot

package "Public" as pubPages {
  rectangle "/" as p_home
  rectangle "/bac-si\n/[id]" as p_doctors
  rectangle "/chuyen-khoa\n/[specialtyId]" as p_specialties
  rectangle "/co-so-y-te\n/[id]" as p_hospitals
  rectangle "/dich-vu" as p_services
  rectangle "/dich-vu/xet-nghiem" as p_lab
  rectangle "/dich-vu/chan-doan-hinh-anh" as p_imaging
  rectangle "/dich-vu/chup-phim-noi-soi" as p_endoscopy
  rectangle "/dich-vu/goi-kham-suc-khoe" as p_packages
  rectangle "/dich-vu/kham-tai-nha" as p_homecare
  rectangle "/dich-vu/kham-thong-tu" as p_circular
  rectangle "/dich-vu/tiem-chung" as p_vaccine
  rectangle "/dich-vu/tu-van-tu-xa" as p_telehealth
  rectangle "/dich-vu/tham-my" as p_aesthetic
  rectangle "/doanh-nghiep" as p_corporate
  rectangle "/dat-lich" as p_booking
  rectangle "/dat-kham-co-so" as p_booking_hospital
  rectangle "/dat-kham-chuyen-khoa/[id]" as p_booking_specialty
  rectangle "/thanh-toan\n/return" as p_payment
  rectangle "/tin-tuc\n/[slug]" as p_news
  rectangle "/huong-dan\n/[slug]" as p_guides
  rectangle "/cau-hoi-thuong-gap" as p_faq
  rectangle "/lien-he" as p_contact
  rectangle "/lien-he-hop-tac" as p_partner
  rectangle "/ve-chung-toi" as p_about
  rectangle "/chinh-sach" as p_policy
  rectangle "/dieu-khoan" as p_terms
  rectangle "/tra-cuu-ho-so" as p_public_record
}

package "Authentication" as authPages {
  rectangle "/dang-nhap" as a_login
  rectangle "/dang-ky" as a_register
  rectangle "/quen-mat-khau" as a_forgot
}

package "Patient Dashboard" as patientPages {
  rectangle "/tai-khoan" as d_account
  rectangle "/ho-so" as d_profile
  rectangle "/lich-kham\n/[id]" as d_appointments
  rectangle "/lich-su-kham" as d_history
  rectangle "/tra-cuu-benh-an" as d_emr
  rectangle "/tu-van\n/[id]" as d_consult
  rectangle "/danh-gia" as d_reviews
  rectangle "/thong-bao" as d_notifications
}

userRoot --> pubPages
userRoot --> authPages
userRoot --> patientPages

note "Smart Screening\ncomponent trong luong dat lich:\nPreExamScreening / AIHealthAssessmentWizard\nScreeningStep2 / ScreeningSummary" as screeningNote
p_booking ..> screeningNote

newpage
title NovaCare - Sitemap quan tri

skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 10

top to bottom direction

rectangle "NovaCare" as adminRoot

package "Platform Admin - ADMIN" as platformPages {
  rectangle "/admin" as ad_dashboard
  rectangle "/admin/hospitals\n/new /[id] /edit" as ad_hospitals
  rectangle "/admin/doctors" as ad_doctors
  rectangle "/admin/schedules" as ad_schedules
  rectangle "/admin/appointments\n/today /history" as ad_appointments
  rectangle "/admin/medical-services" as ad_services
  rectangle "/admin/health-packages" as ad_packages
  rectangle "/admin/specialties" as ad_specialties
  rectangle "/admin/users\n/activity /roles" as ad_users
  rectangle "/admin/partner-requests" as ad_partner
  rectangle "/admin/payments" as ad_payments
  rectangle "/admin/reviews" as ad_reviews
  rectangle "/admin/audit-logs" as ad_audit
  rectangle "/admin/his-sync" as ad_his
  rectangle "/admin/interoperability\n/audit /lookups" as ad_interop
}

package "Hospital Admin - HOSPITAL_ADMIN" as hospitalPages {
  rectangle "/hospital-admin" as ha_dashboard
  rectangle "/hospital-admin/hospital-info" as ha_info
  rectangle "/hospital-admin/integration" as ha_integration
  rectangle "/hospital-admin/doctors" as ha_doctors
  rectangle "/hospital-admin/schedules" as ha_schedules
  rectangle "/hospital-admin/specialties" as ha_specialties
  rectangle "/hospital-admin/services" as ha_services
  rectangle "/hospital-admin/appointments" as ha_appointments
}

package "Menu links chua co page" as missingPages {
  rectangle "/dich-vu/giup-viec" as missing_help
  rectangle "/dich-vu/nha-thuoc" as missing_pharmacy
}

adminRoot --> platformPages
adminRoot --> hospitalPages
adminRoot ..> missingPages

note right of platformPages
  AdminGuard cho phep ADMIN
  va HOSPITAL_ADMIN.
  Backend tiep tuc kiem tra @Roles.
end note

note right of hospitalPages
  HospitalAdminGuard yeu cau
  HOSPITAL_ADMIN co hospitalId.
end note

@enduml
