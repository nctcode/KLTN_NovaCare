@startuml 02_ERD_Tong_The
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam defaultFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam ArrowThickness 1

skinparam ClassBackgroundColor #87CEEB
skinparam ClassHeaderBackgroundColor #87CEEB
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1
skinparam ClassFontColor #000000
skinparam ClassFontSize 11
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 10
skinparam ClassAttributeFontName Arial

skinparam EntityBackgroundColor #87CEEB
skinparam EntityHeaderBackgroundColor #87CEEB
skinparam EntityBorderColor #000000
skinparam EntityBorderThickness 1
skinparam EntityFontColor #000000
skinparam EntityFontSize 11
skinparam EntityFontStyle bold
skinparam EntityAttributeFontColor #000000
skinparam EntityAttributeFontSize 10
skinparam EntityAttributeFontName Arial

skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
skinparam packageBorderThickness 1
skinparam packageFontColor #000000
skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam packageStyle rectangle

skinparam nodesep 45
skinparam ranksep 50
skinparam linetype ortho

hide circle

title SƠ ĐỒ THỰC THỂ LIÊN KẾT TỔNG THỂ (FULL ERD) - NỀN TẢNG Y TẾ SỐ NOVACARE (51 THỰC THỂ)

' ==============================================================================
' 1. PHÂN HỆ TÀI KHOẢN, XÁC THỰC & PHÂN QUYỀN (8 BẢNG)
' ==============================================================================
package "1. Phân hệ Tài khoản, Xác thực & Phân quyền" {
    entity "User" as User {
        * id : String <<PK>>
        --
        email : String <<UK>>
        phone : String <<UK>>
        password : String
        fullName : String
        role : Role
        hospitalId : String <<FK>>
        isActive : Boolean
        createdAt : DateTime
    }

    entity "RefreshToken" as RefreshToken {
        * id : String <<PK>>
        --
        userId : String <<FK>>
        tokenHash : String
        expiresAt : DateTime
        isRevoked : Boolean
    }

    entity "PasswordResetChallenge" as PasswordResetChallenge {
        * userId : String <<PK,FK>>
        --
        otpHash : String
        destination : String
        attempts : Int
        expiresAt : DateTime
    }

    entity "RegistrationOtpChallenge" as RegistrationOtpChallenge {
        * phone : String <<PK>>
        --
        otpHash : String
        expiresAt : DateTime
        isVerified : Boolean
    }

    entity "DeviceToken" as DeviceToken {
        * id : String <<PK>>
        --
        userId : String <<FK>>
        token : String
        deviceType : String
        lastActiveAt : DateTime
    }

    entity "AuditLog" as AuditLog {
        * id : String <<PK>>
        --
        userId : String <<FK>>
        action : String
        entityName : String
        entityId : String
        ipAddress : String
        createdAt : DateTime
    }

    entity "Notification" as Notification {
        * id : String <<PK>>
        --
        userId : String <<FK>>
        title : String
        body : String
        type : NotificationType
        isRead : Boolean
        createdAt : DateTime
    }

    entity "NotificationLog" as NotificationLog {
        * id : String <<PK>>
        --
        notificationId : String <<FK>>
        channel : String
        status : String
        sentAt : DateTime
    }
}

' ==============================================================================
' 2. PHÂN HỆ HỒ SƠ NGƯỜI BỆNH & HỘ CHIẾU Y TẾ (6 BẢNG)
' ==============================================================================
package "2. Phân hệ Hồ sơ Người bệnh & Hộ chiếu Y tế" {
    entity "PatientProfile" as PatientProfile {
        * id : String <<PK>>
        --
        userId : String <<FK>>
        fullName : String
        relationship : String
        dateOfBirth : DateTime
        gender : Gender
        phone : String
        identityCard : String <<UK>>
        healthInsuranceNumber : String
        isDefault : Boolean
    }

    entity "MedicalPassport" as MedicalPassport {
        * id : String <<PK>>
        --
        patientProfileId : String <<PK,FK,UK>>
        passportNumber : String <<UK>>
        qrCode : String
        bloodType : String
        allergies : String
        chronicDiseases : String
    }

    entity "MedicalPassportShare" as MedicalPassportShare {
        * id : String <<PK>>
        --
        passportId : String <<FK>>
        createdBy : String <<FK>>
        shareToken : String <<UK>>
        scope : String
        expiresAt : DateTime
        isRevoked : Boolean
    }

    entity "MedicalPassportAccessLog" as MedicalPassportAccessLog {
        * id : String <<PK>>
        --
        passportId : String <<FK>>
        shareId : String <<FK>>
        accessorId : String
        accessorRole : String
        accessTime : DateTime
    }

    entity "PatientConsent" as PatientConsent {
        * id : String <<PK>>
        --
        patientProfileId : String <<FK>>
        hospitalId : String <<FK>>
        consentStatus : ConsentStatus
        grantedAt : DateTime
        revokedAt : DateTime
    }

    entity "PatientHospitalLink" as PatientHospitalLink {
        * id : String <<PK>>
        --
        patientProfileId : String <<FK>>
        hospitalId : String <<FK>>
        externalPatientId : String
        linkedAt : DateTime
    }
}

' ==============================================================================
' 3. PHÂN HỆ CƠ SỞ Y TẾ, CHUYÊN KHOA & DỊCH VỤ (10 BẢNG)
' ==============================================================================
package "3. Phân hệ Cơ sở Y tế, Chuyên khoa & Dịch vụ" {
    entity "Hospital" as Hospital {
        * id : String <<PK>>
        --
        name : String
        slug : String <<UK>>
        code : String <<UK>>
        type : HospitalType
        partnershipStatus : PartnershipStatus
        province : String
        district : String
        hotline : String
        hisApiEndpoint : String
    }

    entity "HospitalBookingConfig" as HospitalBookingConfig {
        * id : String <<PK>>
        --
        hospitalId : String <<PK,FK,UK>>
        advanceBookingDays : Int
        cancelDeadlineHours : Int
        requiresPrepayment : Boolean
    }

    entity "HospitalBranch" as HospitalBranch {
        * id : String <<PK>>
        --
        hospitalId : String <<FK>>
        branchName : String
        address : String
        isActive : Boolean
    }

    entity "Specialty" as Specialty {
        * id : String <<PK>>
        --
        name : String
        slug : String <<UK>>
        description : String
        isActive : Boolean
    }

    entity "HospitalSpecialty" as HospitalSpecialty {
        * id : String <<PK>>
        --
        hospitalId : String <<FK>>
        specialtyId : String <<FK>>
        status : String
    }

    entity "MedicalService" as MedicalService {
        * id : String <<PK>>
        --
        hospitalId : String <<FK>>
        specialtyId : String <<FK>>
        serviceName : String
        price : Decimal
        isActive : Boolean
    }

    entity "ClinicRoom" as ClinicRoom {
        * id : String <<PK>>
        --
        hospitalId : String <<FK>>
        specialtyId : String <<FK>>
        roomNumber : String
        roomName : String
        isActive : Boolean
    }

    entity "ClinicRoomSession" as ClinicRoomSession {
        * id : String <<PK>>
        --
        clinicRoomId : String <<FK>>
        sessionDate : DateTime
        startTime : Time
        endTime : Time
        maxCapacity : Int
        currentBooked : Int
    }

    entity "HealthPackage" as HealthPackage {
        * id : String <<PK>>
        --
        hospitalId : String <<FK>>
        packageName : String
        price : Decimal
        discountPrice : Decimal
    }

    entity "PartnerRequest" as PartnerRequest {
        * id : String <<PK>>
        --
        hospitalName : String
        contactName : String
        email : String
        phone : String
        licenseNumber : String
        status : PartnerRequestStatus
    }
}

' ==============================================================================
' 4. PHÂN HỆ BÁC SĨ, NƠI LÀM VIỆC & LỊCH TRỰC (5 BẢNG)
' ==============================================================================
package "4. Phân hệ Bác sĩ, Nơi làm việc & Lịch trực" {
    entity "Doctor" as Doctor {
        * id : String <<PK>>
        --
        userId : String <<FK,UK>>
        specialtyId : String <<FK>>
        fullName : String
        slug : String <<UK>>
        title : String
        experienceYears : Int
        ratingAvg : Float
    }

    entity "DoctorWorkplace" as DoctorWorkplace {
        * id : String <<PK>>
        --
        doctorId : String <<FK>>
        hospitalId : String <<FK>>
        clinicRoomId : String <<FK>>
        consultationFee : Decimal
        isActive : Boolean
    }

    entity "DoctorSchedule" as DoctorSchedule {
        * id : String <<PK>>
        --
        doctorWorkplaceId : String <<FK>>
        dayOfWeek : Int
        shift : String
        startTime : Time
        endTime : Time
        slotDurationMinutes : Int
    }

    entity "DoctorScheduleService" as DoctorScheduleService {
        * id : String <<PK>>
        --
        scheduleId : String <<FK>>
        serviceId : String <<FK>>
    }

    entity "ScheduleException" as ScheduleException {
        * id : String <<PK>>
        --
        doctorWorkplaceId : String <<FK>>
        date : DateTime
        exceptionType : ScheduleExceptionType
        reason : String
    }
}

' ==============================================================================
' 5. PHÂN HỆ SUẤT KHÁM, LỊCH HẸN & THANH TOÁN (6 BẢNG)
' ==============================================================================
package "5. Phân hệ Suất khám, Lịch hẹn & Thanh toán" {
    entity "AppointmentSlot" as AppointmentSlot {
        * id : String <<PK>>
        --
        doctorWorkplaceId : String <<FK>>
        date : DateTime
        startTime : Time
        endTime : Time
        status : SlotStatus
        maxCapacity : Int
        currentBooked : Int
        version : Int
    }

    entity "AppointmentSlotBooking" as AppointmentSlotBooking {
        * id : String <<PK>>
        --
        slotId : String <<FK>>
        appointmentId : String <<FK>>
        bookedAt : DateTime
    }

    entity "Appointment" as Appointment {
        * id : String <<PK>>
        --
        appointmentCode : String <<UK>>
        userId : String <<FK>>
        patientProfileId : String <<FK>>
        hospitalId : String <<FK>>
        doctorId : String <<FK>>
        doctorWorkplaceId : String <<FK>>
        slotId : String <<FK>>
        preExamSessionId : String <<FK>>
        appointmentDate : DateTime
        bookingType : BookingType
        status : AppointmentStatus
        checkinAt : DateTime
        totalAmount : Decimal
        reason : String
    }

    entity "AppointmentStatusHistory" as AppointmentStatusHistory {
        * id : String <<PK>>
        --
        appointmentId : String <<FK>>
        fromStatus : AppointmentStatus
        toStatus : AppointmentStatus
        changedBy : String
        createdAt : DateTime
    }

    entity "AppointmentContactLog" as AppointmentContactLog {
        * id : String <<PK>>
        --
        appointmentId : String <<FK>>
        channel : String
        outcome : String
        contactedAt : DateTime
    }

    entity "PaymentTransaction" as PaymentTransaction {
        * id : String <<PK>>
        --
        appointmentId : String <<FK>>
        userId : String <<FK>>
        txnRef : String <<UK>>
        vnpTransactionNo : String
        amount : Decimal
        paymentMethod : PaymentMethod
        status : PaymentStatus
        payDate : DateTime
    }
}

' ==============================================================================
' 6. PHÂN HỆ SÀNG LỌC TIỀN KHÁM AI & SINH HIỆU PPG (3 BẢNG)
' ==============================================================================
package "6. Phân hệ Sàng lọc Tiền khám AI & PPG" {
    entity "PreExamSession" as PreExamSession {
        * id : String <<PK>>
        --
        userId : String <<FK>>
        patientProfileId : String <<FK>>
        chiefComplaint : String
        bodyPart : String
        painScale : Int
        triageLevel : String
        recommendedSpecialtyId : String
        redFlagsDetected : Boolean
        isCompleted : Boolean
    }

    entity "PreExamQuestion" as PreExamQuestion {
        * id : String <<PK>>
        --
        sessionId : String <<FK>>
        questionText : String
        questionType : String
        answer : String
        stepOrder : Int
    }

    entity "ScreeningMedia" as ScreeningMedia {
        * id : String <<PK>>
        --
        sessionId : String <<FK>>
        mediaType : String
        filePath : String
        aiConsentGranted : Boolean
    }
}

' ==============================================================================
' 7. PHÂN HỆ KHÁM BỆNH TỪ XA - TELEMEDICINE (3 BẢNG)
' ==============================================================================
package "7. Phân hệ Khám bệnh Từ xa - Telemedicine" {
    entity "ConsultationSession" as ConsultationSession {
        * id : String <<PK>>
        --
        appointmentId : String <<PK,FK,UK>>
        doctorId : String <<FK>>
        patientProfileId : String <<FK>>
        channel : ConsultationChannel
        status : ConsultationStatus
        livekitRoomName : String
        startedAt : DateTime
        endedAt : DateTime
    }

    entity "ConsultationMessage" as ConsultationMessage {
        * id : String <<PK>>
        --
        sessionId : String <<FK>>
        senderId : String <<FK>>
        senderType : ConsultationSenderType
        messageType : ConsultationMessageType
        content : String
        isRead : Boolean
    }

    entity "ConsultationAttachment" as ConsultationAttachment {
        * id : String <<PK>>
        --
        sessionId : String <<FK>>
        fileName : String
        fileUrl : String
        fileSize : Int
    }
}

' ==============================================================================
' 8. PHÂN HỆ HỒ SƠ LÂM SÀNG, CHẨN ĐOÁN & ĐƠN THUỐC (5 BẢNG)
' ==============================================================================
package "8. Phân hệ Hồ sơ Lâm sàng & EMR" {
    entity "MedicalEncounter" as MedicalEncounter {
        * id : String <<PK>>
        --
        encounterCode : String <<UK>>
        patientProfileId : String <<FK>>
        doctorId : String <<FK>>
        hospitalId : String <<FK>>
        appointmentId : String <<FK>>
        encounterDate : DateTime
        status : EncounterStatus
        isPublished : Boolean
    }

    entity "Diagnosis" as Diagnosis {
        * id : String <<PK>>
        --
        encounterId : String <<FK>>
        icd10Code : String
        diseaseName : String
        isPrimary : Boolean
    }

    entity "Observation" as Observation {
        * id : String <<PK>>
        --
        encounterId : String <<FK>>
        category : ObservationCategory
        code : String
        name : String
        value : String
        unit : String
    }

    entity "Prescription" as Prescription {
        * id : String <<PK>>
        --
        encounterId : String <<FK>>
        doctorId : String <<FK>>
        prescriptionCode : String <<UK>>
        instructions : String
        revisitDate : DateTime
    }

    entity "PrescriptionItem" as PrescriptionItem {
        * id : String <<PK>>
        --
        prescriptionId : String <<FK>>
        medicationName : String
        dosage : String
        quantity : Int
        unit : String
    }
}

' ==============================================================================
' 9. PHÂN HỆ ĐÁNH GIÁ & KIỂM DUYỆT CHẤT LƯỢNG (5 BẢNG)
' ==============================================================================
package "9. Phân hệ Đánh giá & Kiểm duyệt" {
    entity "Review" as Review {
        * id : String <<PK>>
        --
        appointmentId : String <<PK,FK,UK>>
        userId : String <<FK>>
        targetType : ReviewTargetType
        targetId : String
        rating : Int
        comment : String
        status : ReviewStatus
    }

    entity "ReviewCriteriaScore" as ReviewCriteriaScore {
        * id : String <<PK>>
        --
        reviewId : String <<PK,FK,UK>>
        doctorAttitude : Int
        examinationQuality : Int
        hospitalWaitingTime : Int
        hospitalStaffAttitude : Int
        hospitalCleanliness : Int
    }

    entity "ReviewResponse" as ReviewResponse {
        * id : String <<PK>>
        --
        reviewId : String <<FK>>
        responderId : String <<FK>>
        content : String
        responderRole : String
    }

    entity "ReviewModerationLog" as ReviewModerationLog {
        * id : String <<PK>>
        --
        reviewId : String <<FK>>
        moderatorId : String <<FK>>
        action : String
        reason : String
    }

    entity "ReviewReport" as ReviewReport {
        * id : String <<PK>>
        --
        reviewId : String <<FK>>
        reporterId : String <<FK>>
        reason : ReportReason
        description : String
        isResolved : Boolean
    }
}

' ==============================================================================
' QUAN HỆ TRONG PHÂN HỆ & LIÊN PHÂN HỆ (CROSS-MODULE RELATIONS)
' ==============================================================================

' 1. User relations
User ||--o{ RefreshToken : "has"
User ||--o| PasswordResetChallenge : "requests"
User ||--o{ DeviceToken : "binds"
User ||--o{ AuditLog : "logs"
User ||--o{ Notification : "receives"
Notification ||--o{ NotificationLog : "logs_delivery"
User ||--o{ PatientProfile : "manages"
User ||--o| Doctor : "authenticates"
User ||--o{ Appointment : "creates"
User ||--o{ PaymentTransaction : "pays"
User ||--o{ Review : "authors"

' 2. PatientProfile & Passport
PatientProfile ||--|| MedicalPassport : "owns"
MedicalPassport ||--o{ MedicalPassportShare : "shares"
MedicalPassport ||--o{ MedicalPassportAccessLog : "accesses"
MedicalPassportShare ||--o{ MedicalPassportAccessLog : "accessed_via"
PatientProfile ||--o{ PatientConsent : "consents"
PatientProfile ||--o{ PatientHospitalLink : "links_mpi"
PatientProfile ||--o{ PreExamSession : "triage_session"
PatientProfile ||--o{ Appointment : "is_patient"
PatientProfile ||--o{ MedicalEncounter : "patient_history"

' 3. Hospital, Specialty & Services
Hospital ||--o| HospitalBookingConfig : "configures"
Hospital ||--o{ HospitalBranch : "branches"
Hospital ||--o{ HospitalSpecialty : "offers"
Specialty ||--o{ HospitalSpecialty : "in_hospital"
Hospital ||--o{ MedicalService : "lists_service"
Specialty ||--o{ MedicalService : "categorizes_service"
Hospital ||--o{ ClinicRoom : "has_room"
Specialty ||--o{ ClinicRoom : "room_specialty"
ClinicRoom ||--o{ ClinicRoomSession : "sessions"
Hospital ||--o{ HealthPackage : "packages"
Hospital ||--o{ PatientConsent : "received_consent"
Hospital ||--o{ PatientHospitalLink : "hospital_mpi"
Hospital ||--o{ Appointment : "hosts_appointment"
Hospital ||--o{ MedicalEncounter : "encounter_facility"

' 4. Doctor & Workplace
Doctor ||--|| Specialty : "primary_specialty"
Doctor ||--o{ DoctorWorkplace : "practices_in"
Hospital ||--o{ DoctorWorkplace : "hires"
ClinicRoom ||--o{ DoctorWorkplace : "room_workplace"
DoctorWorkplace ||--o{ DoctorSchedule : "schedules"
DoctorSchedule ||--o{ DoctorScheduleService : "services"
MedicalService ||--o{ DoctorScheduleService : "in_schedule"
DoctorWorkplace ||--o{ ScheduleException : "exceptions"
DoctorWorkplace ||--o{ AppointmentSlot : "slots"
Doctor ||--o{ Appointment : "assigned_doctor"
Doctor ||--o{ ConsultationSession : "doctor_tele"
Doctor ||--o{ MedicalEncounter : "attending_doctor"

' 5. Appointment & Transactions
AppointmentSlot ||--o{ AppointmentSlotBooking : "holding"
Appointment ||--o{ AppointmentSlotBooking : "booked_slot"
Appointment ||--o| AppointmentSlot : "main_slot_ref"
DoctorWorkplace ||--o{ Appointment : "workplace_appt"
Appointment ||--o{ AppointmentStatusHistory : "timeline"
Appointment ||--o{ AppointmentContactLog : "contacts"
Appointment ||--o| PaymentTransaction : "settled_by"
Appointment ||--o| ConsultationSession : "tele_session"
Appointment ||--o| MedicalEncounter : "clinical_encounter"
Appointment ||--o| Review : "rated_by"
PreExamSession ||--o| Appointment : "recommended_to"

' 6. PreExam AI
PreExamSession ||--o{ PreExamQuestion : "questions"
PreExamSession ||--o{ ScreeningMedia : "media"

' 7. Telemedicine
ConsultationSession ||--o{ ConsultationMessage : "messages"
ConsultationSession ||--o{ ConsultationAttachment : "attachments"
User ||--o{ ConsultationMessage : "sent_by"

' 8. Clinical EMR
MedicalEncounter ||--o{ Diagnosis : "diagnoses"
MedicalEncounter ||--o{ Observation : "observations"
MedicalEncounter ||--o{ Prescription : "prescriptions"
Prescription ||--o{ PrescriptionItem : "items"
MedicalEncounter ||--o| MedicalPassport : "published_into"

' 9. Reviews
Review ||--|| ReviewCriteriaScore : "scores"
Review ||--o{ ReviewResponse : "responses"
Review ||--o{ ReviewModerationLog : "moderations"
Review ||--o{ ReviewReport : "reports"
User ||--o{ ReviewResponse : "responded_by"
User ||--o{ ReviewReport : "reported_by"
User ||--o{ ReviewModerationLog : "moderated_by"

@enduml

