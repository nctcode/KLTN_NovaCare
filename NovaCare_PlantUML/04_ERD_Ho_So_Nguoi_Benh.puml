@startuml 04_ERD_Ho_So_Nguoi_Benh
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam ArrowThickness 1

skinparam ClassBackgroundColor #87CEEB
skinparam ClassHeaderBackgroundColor #87CEEB
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1
skinparam ClassFontColor #000000
skinparam ClassFontSize 12
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 11
skinparam ClassAttributeFontName Arial

skinparam EntityBackgroundColor #87CEEB
skinparam EntityHeaderBackgroundColor #87CEEB
skinparam EntityBorderColor #000000
skinparam EntityBorderThickness 1
skinparam EntityFontColor #000000
skinparam EntityFontSize 12
skinparam EntityFontStyle bold
skinparam EntityAttributeFontColor #000000
skinparam EntityAttributeFontSize 11
skinparam EntityAttributeFontName Arial

skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
skinparam packageBorderThickness 1
skinparam packageFontColor #000000
skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam packageStyle rectangle

skinparam nodesep 50
skinparam ranksep 50
skinparam linetype ortho

hide circle

title ERD PHÂN HỆ HỒ SƠ NGƯỜI BỆNH & HỘ CHIẾU Y TẾ (6 THỰC THỂ)

entity "PatientProfile" as PatientProfile {
    * id : String <<PK>>
    --
    userId : String <<FK>>
    fullName : String
    relationship : String
    dateOfBirth : DateTime
    gender : Gender
    phone : String
    identityCard : String <<UK>>
    healthInsuranceNumber : String
    address : String
    medicalHistory : String
    allergies : String
    bloodType : String
    isDefault : Boolean
    createdAt : DateTime
    updatedAt : DateTime
}

entity "MedicalPassport" as MedicalPassport {
    * id : String <<PK>>
    --
    patientProfileId : String <<PK,FK,UK>>
    passportNumber : String <<UK>>
    qrCode : String
    bloodType : String
    allergies : String
    chronicDiseases : String
    createdAt : DateTime
    updatedAt : DateTime
}

entity "MedicalPassportShare" as MedicalPassportShare {
    * id : String <<PK>>
    --
    passportId : String <<FK>>
    createdBy : String <<FK>>
    shareToken : String <<UK>>
    scope : String
    expiresAt : DateTime
    isRevoked : Boolean
    revokedAt : DateTime
    createdAt : DateTime
}

entity "MedicalPassportAccessLog" as MedicalPassportAccessLog {
    * id : String <<PK>>
    --
    passportId : String <<FK>>
    shareId : String <<FK>>
    accessorId : String
    accessorRole : String
    hospitalId : String
    ipAddress : String
    accessTime : DateTime
}

entity "PatientConsent" as PatientConsent {
    * id : String <<PK>>
    --
    patientProfileId : String <<FK>>
    hospitalId : String <<FK>>
    consentStatus : ConsentStatus
    termsVersion : String
    grantedAt : DateTime
    revokedAt : DateTime
    createdAt : DateTime
}

entity "PatientHospitalLink" as PatientHospitalLink {
    * id : String <<PK>>
    --
    patientProfileId : String <<FK>>
    hospitalId : String <<FK>>
    externalPatientId : String
    dataSource : DataSource
    linkedAt : DateTime
    createdAt : DateTime
}

PatientProfile ||--|| MedicalPassport : "sở hữu duy nhất 1-1"
MedicalPassport ||--o{ MedicalPassportShare : "tạo mã chia sẻ"
MedicalPassport ||--o{ MedicalPassportAccessLog : "ghi nhật ký xem"
MedicalPassportShare ||--o{ MedicalPassportAccessLog : "truy cập qua token"
PatientProfile ||--o{ PatientConsent : "cấp quyền liên thông"
PatientProfile ||--o{ PatientHospitalLink : "ánh xạ mã bệnh nhân MPI"

@enduml

