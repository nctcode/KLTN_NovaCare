@startuml 05_ERD_Co_So_Y_Te
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam ArrowThickness 1

skinparam ClassBackgroundColor #87CEEB
skinparam ClassHeaderBackgroundColor #87CEEB
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1
skinparam ClassFontColor #000000
skinparam ClassFontSize 12
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 11
skinparam ClassAttributeFontName Arial

skinparam EntityBackgroundColor #87CEEB
skinparam EntityHeaderBackgroundColor #87CEEB
skinparam EntityBorderColor #000000
skinparam EntityBorderThickness 1
skinparam EntityFontColor #000000
skinparam EntityFontSize 12
skinparam EntityFontStyle bold
skinparam EntityAttributeFontColor #000000
skinparam EntityAttributeFontSize 11
skinparam EntityAttributeFontName Arial

skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
skinparam packageBorderThickness 1
skinparam packageFontColor #000000
skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam packageStyle rectangle

skinparam nodesep 50
skinparam ranksep 50
skinparam linetype ortho

hide circle

title ERD PHÂN HỆ CƠ SỞ Y TẾ, CHUYÊN KHOA & DỊCH VỤ (10 THỰC THỂ)

entity "Hospital" as Hospital {
    * id : String <<PK>>
    --
    name : String
    slug : String <<UK>>
    code : String <<UK>>
    type : HospitalType
    partnershipStatus : PartnershipStatus
    address : String
    province : String
    district : String
    latitude : Float
    longitude : Float
    hotline : String
    email : String
    logoUrl : String
    bannerUrl : String
    hisApiEndpoint : String
    hisApiKey : String
    createdAt : DateTime
    updatedAt : DateTime
}

entity "HospitalBookingConfig" as HospitalBookingConfig {
    * id : String <<PK>>
    --
    hospitalId : String <<PK,FK,UK>>
    advanceBookingDays : Int
    cancelDeadlineHours : Int
    rescheduleDeadlineHours : Int
    requiresPrepayment : Boolean
    allowCashAtHospital : Boolean
    updatedAt : DateTime
}

entity "HospitalBranch" as HospitalBranch {
    * id : String <<PK>>
    --
    hospitalId : String <<FK>>
    branchName : String
    address : String
    phone : String
    isActive : Boolean
    createdAt : DateTime
}

entity "Specialty" as Specialty {
    * id : String <<PK>>
    --
    name : String
    slug : String <<UK>>
    description : String
    iconUrl : String
    isActive : Boolean
    createdAt : DateTime
    updatedAt : DateTime
}

entity "HospitalSpecialty" as HospitalSpecialty {
    * id : String <<PK>>
    --
    hospitalId : String <<FK>>
    specialtyId : String <<FK>>
    status : String
    description : String
    createdAt : DateTime
}

entity "MedicalService" as MedicalService {
    * id : String <<PK>>
    --
    hospitalId : String <<FK>>
    specialtyId : String <<FK>>
    serviceName : String
    serviceCode : String
    price : Decimal
    description : String
    isActive : Boolean
    createdAt : DateTime
}

entity "ClinicRoom" as ClinicRoom {
    * id : String <<PK>>
    --
    hospitalId : String <<FK>>
    specialtyId : String <<FK>>
    roomNumber : String
    roomName : String
    locationNotes : String
    isActive : Boolean
    createdAt : DateTime
}

entity "ClinicRoomSession" as ClinicRoomSession {
    * id : String <<PK>>
    --
    clinicRoomId : String <<FK>>
    sessionDate : DateTime
    startTime : Time
    endTime : Time
    maxCapacity : Int
    currentBooked : Int
    createdAt : DateTime
}

entity "HealthPackage" as HealthPackage {
    * id : String <<PK>>
    --
    hospitalId : String <<FK>>
    packageName : String
    price : Decimal
    discountPrice : Decimal
    targetAudience : String
    detailsJson : Json
    isActive : Boolean
    createdAt : DateTime
}

entity "PartnerRequest" as PartnerRequest {
    * id : String <<PK>>
    --
    hospitalName : String
    contactName : String
    email : String
    phone : String
    licenseNumber : String
    licenseImageUrl : String
    status : PartnerRequestStatus
    reviewNotes : String
    createdAt : DateTime
    updatedAt : DateTime
}

Hospital ||--o| HospitalBookingConfig : "cấu hình quy tắc đặt lịch (1-1)"
Hospital ||--o{ HospitalBranch : "quản lý chi nhánh"
Hospital ||--o{ HospitalSpecialty : "tiếp nhận chuyên khoa"
Specialty ||--o{ HospitalSpecialty : "phân bổ tại viện"
Hospital ||--o{ MedicalService : "niêm yết bảng giá"
Specialty ||--o{ MedicalService : "thuộc chuyên khoa"
Hospital ||--o{ ClinicRoom : "bố trí phòng khám"
Specialty ||--o{ ClinicRoom : "phòng chuyên khoa"
ClinicRoom ||--o{ ClinicRoomSession : "tổ chức các phiên khám"
Hospital ||--o{ HealthPackage : "cung cấp gói khám"

@enduml

