@startuml 06_ERD_Bac_Si_Lich_Truc
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam ArrowThickness 1

skinparam ClassBackgroundColor #87CEEB
skinparam ClassHeaderBackgroundColor #87CEEB
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1
skinparam ClassFontColor #000000
skinparam ClassFontSize 12
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 11
skinparam ClassAttributeFontName Arial

skinparam EntityBackgroundColor #87CEEB
skinparam EntityHeaderBackgroundColor #87CEEB
skinparam EntityBorderColor #000000
skinparam EntityBorderThickness 1
skinparam EntityFontColor #000000
skinparam EntityFontSize 12
skinparam EntityFontStyle bold
skinparam EntityAttributeFontColor #000000
skinparam EntityAttributeFontSize 11
skinparam EntityAttributeFontName Arial

skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
skinparam packageBorderThickness 1
skinparam packageFontColor #000000
skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam packageStyle rectangle

skinparam nodesep 50
skinparam ranksep 50
skinparam linetype ortho

hide circle

title ERD PHÂN HỆ BÁC SĨ, NƠI LÀM VIỆC & LỊCH TRỰC (5 THỰC THỂ)

entity "Doctor" as Doctor {
    * id : String <<PK>>
    --
    userId : String <<FK,UK>>
    specialtyId : String <<FK>>
    fullName : String
    slug : String <<UK>>
    title : String
    experienceYears : Int
    biography : String
    avatarUrl : String
    ratingAvg : Float
    ratingCount : Int
    isActive : Boolean
    createdAt : DateTime
    updatedAt : DateTime
}

entity "DoctorWorkplace" as DoctorWorkplace {
    * id : String <<PK>>
    --
    doctorId : String <<FK>>
    hospitalId : String <<FK>>
    clinicRoomId : String <<FK>>
    consultationFee : Decimal
    isActive : Boolean
    createdAt : DateTime
    updatedAt : DateTime
}

entity "DoctorSchedule" as DoctorSchedule {
    * id : String <<PK>>
    --
    doctorWorkplaceId : String <<FK>>
    dayOfWeek : Int
    shift : String
    startTime : Time
    endTime : Time
    slotDurationMinutes : Int
    maxPatientsPerSlot : Int
    isActive : Boolean
    createdAt : DateTime
}

entity "DoctorScheduleService" as DoctorScheduleService {
    * id : String <<PK>>
    --
    scheduleId : String <<FK>>
    serviceId : String <<FK>>
    createdAt : DateTime
}

entity "ScheduleException" as ScheduleException {
    * id : String <<PK>>
    --
    doctorWorkplaceId : String <<FK>>
    date : DateTime
    exceptionType : ScheduleExceptionType
    startTime : Time
    endTime : Time
    reason : String
    createdAt : DateTime
}

Doctor ||--o{ DoctorWorkplace : "liên kết nơi làm việc"
DoctorWorkplace ||--o{ DoctorSchedule : "phân công ca trực định kỳ"
DoctorSchedule ||--o{ DoctorScheduleService : "thực hiện dịch vụ kỹ thuật"
DoctorWorkplace ||--o{ ScheduleException : "ghi nhận ngoại lệ/nghỉ phép"

@enduml

