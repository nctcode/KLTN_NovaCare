@startuml 08_ERD_AI_Sang_Loc
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam ArrowThickness 1

skinparam ClassBackgroundColor #87CEEB
skinparam ClassHeaderBackgroundColor #87CEEB
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1
skinparam ClassFontColor #000000
skinparam ClassFontSize 12
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 11
skinparam ClassAttributeFontName Arial

skinparam EntityBackgroundColor #87CEEB
skinparam EntityHeaderBackgroundColor #87CEEB
skinparam EntityBorderColor #000000
skinparam EntityBorderThickness 1
skinparam EntityFontColor #000000
skinparam EntityFontSize 12
skinparam EntityFontStyle bold
skinparam EntityAttributeFontColor #000000
skinparam EntityAttributeFontSize 11
skinparam EntityAttributeFontName Arial

skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
skinparam packageBorderThickness 1
skinparam packageFontColor #000000
skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam packageStyle rectangle

skinparam nodesep 50
skinparam ranksep 50
skinparam linetype ortho

hide circle

title ERD PHÂN HỆ SÀNG LỌC TIỀN KHÁM AI & SINH HIỆU PPG (3 THỰC THỂ)

entity "PreExamSession" as PreExamSession {
    * id : String <<PK>>
    --
    userId : String <<FK>>
    patientProfileId : String <<FK>>
    chiefComplaint : String
    bodyPart : String
    painScale : Int
    onsetDays : String
    associatedSymptoms : String
    triageLevel : String
    recommendedSpecialtyId : String
    recommendationReason : String
    redFlagsDetected : Boolean
    redFlagsNotes : String
    heartRateBpm : Int
    isCompleted : Boolean
    completedAt : DateTime
    createdAt : DateTime
    updatedAt : DateTime
}

entity "PreExamQuestion" as PreExamQuestion {
    * id : String <<PK>>
    --
    sessionId : String <<FK>>
    questionText : String
    questionType : String
    optionsJson : Json
    answer : String
    stepOrder : Int
    createdAt : DateTime
}

entity "ScreeningMedia" as ScreeningMedia {
    * id : String <<PK>>
    --
    sessionId : String <<FK>>
    mediaType : String
    filePath : String
    fileSize : Int
    aiConsentGranted : Boolean
    consentTimestamp : DateTime
    analysisResult : Json
    createdAt : DateTime
}

PreExamSession ||--o{ PreExamQuestion : "câu hỏi phân nhánh thích ứng"
PreExamSession ||--o{ ScreeningMedia : "ảnh tổn thương / video PPG"

@enduml

