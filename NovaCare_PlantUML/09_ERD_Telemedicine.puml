@startuml 09_ERD_Telemedicine
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam ArrowThickness 1

skinparam ClassBackgroundColor #87CEEB
skinparam ClassHeaderBackgroundColor #87CEEB
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1
skinparam ClassFontColor #000000
skinparam ClassFontSize 12
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 11
skinparam ClassAttributeFontName Arial

skinparam EntityBackgroundColor #87CEEB
skinparam EntityHeaderBackgroundColor #87CEEB
skinparam EntityBorderColor #000000
skinparam EntityBorderThickness 1
skinparam EntityFontColor #000000
skinparam EntityFontSize 12
skinparam EntityFontStyle bold
skinparam EntityAttributeFontColor #000000
skinparam EntityAttributeFontSize 11
skinparam EntityAttributeFontName Arial

skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
skinparam packageBorderThickness 1
skinparam packageFontColor #000000
skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam packageStyle rectangle

skinparam nodesep 50
skinparam ranksep 50
skinparam linetype ortho

hide circle

title ERD PHÂN HỆ KHÁM BỆNH TỪ XA - TELEMEDICINE (3 THỰC THỂ)

entity "ConsultationSession" as ConsultationSession {
    * id : String <<PK>>
    --
    appointmentId : String <<PK,FK,UK>>
    doctorId : String <<FK>>
    patientProfileId : String <<FK>>
    channel : ConsultationChannel
    status : ConsultationStatus
    livekitRoomName : String
    livekitRoomSid : String
    startedAt : DateTime
    endedAt : DateTime
    doctorNotes : String
    prescriptionSummary : String
    createdAt : DateTime
    updatedAt : DateTime
}

entity "ConsultationMessage" as ConsultationMessage {
    * id : String <<PK>>
    --
    sessionId : String <<FK>>
    senderId : String <<FK>>
    senderType : ConsultationSenderType
    messageType : ConsultationMessageType
    content : String
    isRead : Boolean
    readAt : DateTime
    createdAt : DateTime
}

entity "ConsultationAttachment" as ConsultationAttachment {
    * id : String <<PK>>
    --
    sessionId : String <<FK>>
    fileName : String
    fileUrl : String
    fileSize : Int
    mimeType : String
    uploadedBy : String
    createdAt : DateTime
}

ConsultationSession ||--o{ ConsultationMessage : "tin nhắn trao đổi thời gian thực"
ConsultationSession ||--o{ ConsultationAttachment : "tệp hồ sơ bệnh án đính kèm"

@enduml

