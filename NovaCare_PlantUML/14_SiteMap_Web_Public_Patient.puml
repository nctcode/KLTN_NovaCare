
@startuml 14_SiteMap_Web_Public_Patient

!theme plain

' =========================
' CẤU HÌNH CHUNG
' =========================
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam defaultFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowThickness 1

skinparam linetype ortho
skinparam nodesep 8
skinparam ranksep 20
skinparam padding 4

' =========================
' CẤU HÌNH CÁC Ô
' =========================
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #000000
    BorderThickness 1
    FontColor #000000
    FontSize 10
    FontStyle bold
    RoundCorner 0
    MinimumWidth 110
    MaximumWidth 110
}

' =========================
' CẤU HÌNH PACKAGE
' =========================
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #000000
    BorderThickness 1
    FontColor #000000
    FontSize 10
    FontStyle bold
    Style rectangle
}

' =========================
' ROOT
' =========================
rectangle "CỔNG WEB\nNOVACARE" as Web_Root

' =========================
' A. CỔNG THÔNG TIN CÔNG CỘNG
' =========================
package "A. Cổng thông tin công cộng" as P_PublicWeb {

    package "1. Giới thiệu & Khám phá" as Sub_Intro {
        rectangle "Trang chủ" as Pub_Home
        rectangle "Tìm cơ sở\ny tế" as Pub_Hosp
        rectangle "Danh bạ\nbác sĩ" as Pub_Doc
        rectangle "Chuyên khoa\ny tế" as Pub_Spec
    }

    package "2. Dịch vụ & Gói khám" as Sub_Services {
        rectangle "Dịch vụ kỹ thuật\ny tế" as Pub_Service
        rectangle "Gói khám\nsức khỏe" as Pub_Package
        rectangle "Tra cứu nhanh\nhồ sơ" as Pub_SearchFast
    }

    package "3. Thông tin & Xác thực" as Sub_InfoAuth {
        rectangle "Tin tức\n& Cẩm nang y khoa" as Pub_News
        rectangle "Đăng nhập\n& Đăng ký" as Pub_Auth
        rectangle "Liên hệ\n& Hợp tác" as Pub_Contact
    }
}

' =========================
' B. CỔNG NGƯỜI BỆNH
' =========================
package "B. Cổng người bệnh" as P_PatientWeb {

    package "4. Quản lý y tế cá nhân" as Sub_Medical {
        rectangle "Tổng quan\ncá nhân" as Pat_Dashboard
        rectangle "Hồ sơ sức khỏe\ngia đình" as Pat_Profile
        rectangle "Hộ chiếu y tế\nđiện tử" as Pat_Passport
    }

    package "5. Đặt lịch & Khám bệnh" as Sub_Booking {
        rectangle "Đặt lịch khám\ntrực tuyến" as Pat_Book
        rectangle "Quản lý\nlịch hẹn" as Pat_Appt
        rectangle "Thanh toán\nviện phí" as Pat_Payment
        rectangle "Khám từ xa\nTelemedicine" as Pat_Tele
    }

    package "6. Bệnh án & Tương tác" as Sub_Interaction {
        rectangle "Lịch sử khám\n& Bệnh án EMR" as Pat_EMR
        rectangle "Đánh giá\nchất lượng dịch vụ" as Pat_Review
        rectangle "Thông báo\n& Cài đặt" as Pat_Settings
    }
}

' =========================
' KẾT NỐI ROOT
' =========================
Web_Root -down-> P_PublicWeb
Web_Root -down-> P_PatientWeb

' =========================
' KẾT NỐI GIỚI THIỆU
' =========================
Pub_Home -down-> Pub_Hosp
Pub_Hosp -down-> Pub_Doc
Pub_Doc -down-> Pub_Spec

' =========================
' KẾT NỐI DỊCH VỤ
' =========================
Pub_Service -down-> Pub_Package
Pub_Package -down-> Pub_SearchFast

' =========================
' KẾT NỐI THÔNG TIN
' =========================
Pub_News -down-> Pub_Auth
Pub_Auth -down-> Pub_Contact

' =========================
' KẾT NỐI HỒ SƠ CÁ NHÂN
' =========================
Pat_Dashboard -down-> Pat_Profile
Pat_Profile -down-> Pat_Passport

' =========================
' KẾT NỐI ĐẶT LỊCH
' =========================
Pat_Book -down-> Pat_Appt
Pat_Appt -down-> Pat_Payment
Pat_Payment -down-> Pat_Tele

' =========================
' KẾT NỐI BỆNH ÁN
' =========================
Pat_EMR -down-> Pat_Review
Pat_Review -down-> Pat_Settings

@enduml
