
@startuml 15_SiteMap_Hospital_Admin

!theme plain

' =========================
' CẤU HÌNH CHUNG
' =========================
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam defaultFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowThickness 1

skinparam linetype ortho
skinparam nodesep 8
skinparam ranksep 20
skinparam padding 4

' =========================
' CẤU HÌNH CÁC Ô
' =========================
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #000000
    BorderThickness 1
    FontColor #000000
    FontSize 10
    FontStyle bold
    RoundCorner 0
    MinimumWidth 110
    MaximumWidth 110
}

' =========================
' CẤU HÌNH PACKAGE
' =========================
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #000000
    BorderThickness 1
    FontColor #000000
    FontSize 10
    FontStyle bold
    Style rectangle
}

' =========================
' ROOT
' =========================
rectangle "QUẢN TRỊ\nCƠ SỞ Y TẾ" as Hosp_Root

' =========================
' 1. DASHBOARD CƠ SỞ Y TẾ
' =========================
package "1. Dashboard cơ sở y tế" as P_HospDash {
    rectangle "Thống kê ca khám\ntrong ngày" as Dash_Today
    rectangle "Doanh thu\nviện phí" as Dash_Revenue
    rectangle "Tỷ lệ sử dụng\nphòng khám" as Dash_Occupancy
}

' =========================
' 2. TIẾP ĐÓN & LỊCH KHÁM
' =========================
package "2. Tiếp đón & Lịch khám" as P_HospAppts {
    rectangle "Danh sách\ntiếp đón" as Appt_Queue
    rectangle "Check-in QR\nngười bệnh" as Appt_Checkin
    rectangle "Điều phối\nca khám" as Appt_Status
    rectangle "In phiếu\nthứ tự khám" as Appt_Print
}

' =========================
' 3. BÁC SĨ & NHÂN SỰ
' =========================
package "3. Bác sĩ & Nhân sự" as P_HospDocs {
    rectangle "Danh sách\nbác sĩ" as Doc_List
    rectangle "Phân công\nphòng khám" as Doc_Room
    rectangle "Biểu phí\nkhám bệnh" as Doc_Fee
}

' =========================
' 4. PHÒNG KHÁM & LỊCH TRỰC
' =========================
package "4. Phòng khám & Lịch trực" as P_HospSched {
    rectangle "Lịch trực\nbác sĩ" as Sched_Weekly
    rectangle "Tạo suất khám\ntự động (Slots)" as Sched_Slots
    rectangle "Báo bận\n& Nghỉ trực" as Sched_Exceptions
}

' =========================
' 5. DỊCH VỤ & CHUYÊN KHOA
' =========================
package "5. Dịch vụ & Chuyên khoa" as P_HospCatalog {
    rectangle "Danh mục\ndịch vụ kỹ thuật" as Serv_List
    rectangle "Đơn giá\n& BHYT" as Serv_Price
    rectangle "Chuyên khoa\ntiếp nhận" as Serv_Spec
}

' =========================
' 6. CẤU HÌNH & TÍCH HỢP HIS
' =========================
package "6. Cấu hình & Tích hợp HIS" as P_HospConfig {
    rectangle "Thông tin cơ sở\n& Chi nhánh" as Conf_Info
    rectangle "Quy định\nđặt lịch" as Conf_Rules
    rectangle "Đồng bộ\ndữ liệu HIS" as Conf_HIS
}

' =========================
' KẾT NỐI ROOT
' =========================
Hosp_Root -down-> P_HospDash
Hosp_Root -down-> P_HospAppts
Hosp_Root -down-> P_HospDocs
Hosp_Root -down-> P_HospSched
Hosp_Root -down-> P_HospCatalog
Hosp_Root -down-> P_HospConfig

' =========================
' KẾT NỐI DASHBOARD
' =========================
Dash_Today -down-> Dash_Revenue
Dash_Revenue -down-> Dash_Occupancy

' =========================
' KẾT NỐI TIẾP ĐÓN
' =========================
Appt_Queue -down-> Appt_Checkin
Appt_Checkin -down-> Appt_Status
Appt_Status -down-> Appt_Print

' =========================
' KẾT NỐI BÁC SĨ
' =========================
Doc_List -down-> Doc_Room
Doc_Room -down-> Doc_Fee

' =========================
' KẾT NỐI LỊCH TRỰC
' =========================
Sched_Weekly -down-> Sched_Slots
Sched_Slots -down-> Sched_Exceptions

' =========================
' KẾT NỐI DỊCH VỤ
' =========================
Serv_List -down-> Serv_Price
Serv_Price -down-> Serv_Spec

' =========================
' KẾT NỐI CẤU HÌNH
' =========================
Conf_Info -down-> Conf_Rules
Conf_Rules -down-> Conf_HIS

@enduml
