@startuml 10_ERD_EMR
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam ArrowThickness 1

skinparam ClassBackgroundColor #87CEEB
skinparam ClassHeaderBackgroundColor #87CEEB
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1
skinparam ClassFontColor #000000
skinparam ClassFontSize 12
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 11
skinparam ClassAttributeFontName Arial

skinparam EntityBackgroundColor #87CEEB
skinparam EntityHeaderBackgroundColor #87CEEB
skinparam EntityBorderColor #000000
skinparam EntityBorderThickness 1
skinparam EntityFontColor #000000
skinparam EntityFontSize 12
skinparam EntityFontStyle bold
skinparam EntityAttributeFontColor #000000
skinparam EntityAttributeFontSize 11
skinparam EntityAttributeFontName Arial

skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
skinparam packageBorderThickness 1
skinparam packageFontColor #000000
skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam packageStyle rectangle

skinparam nodesep 50
skinparam ranksep 50
skinparam linetype ortho

hide circle

title ERD PHÂN HỆ HỒ SƠ LÂM SÀNG, CHẨN ĐOÁN & ĐƠN THUỐC - EMR (5 THỰC THỂ)

entity "MedicalEncounter" as MedicalEncounter {
    * id : String <<PK>>
    --
    encounterCode : String <<UK>>
    patientProfileId : String <<FK>>
    doctorId : String <<FK>>
    hospitalId : String <<FK>>
    appointmentId : String <<FK>>
    encounterDate : DateTime
    status : EncounterStatus
    chiefComplaint : String
    clinicalNotes : String
    dischargeNotes : String
    isPublished : Boolean
    publishedAt : DateTime
    createdAt : DateTime
    updatedAt : DateTime
}

entity "Diagnosis" as Diagnosis {
    * id : String <<PK>>
    --
    encounterId : String <<FK>>
    icd10Code : String
    diseaseName : String
    isPrimary : Boolean
    clinicalNotes : String
    createdAt : DateTime
}

entity "Observation" as Observation {
    * id : String <<PK>>
    --
    encounterId : String <<FK>>
    category : ObservationCategory
    code : String
    name : String
    value : String
    unit : String
    referenceRange : String
    isAbnormal : Boolean
    observedAt : DateTime
    createdAt : DateTime
}

entity "Prescription" as Prescription {
    * id : String <<PK>>
    --
    encounterId : String <<FK>>
    doctorId : String <<FK>>
    prescriptionCode : String <<UK>>
    instructions : String
    revisitDate : DateTime
    createdAt : DateTime
    updatedAt : DateTime
}

entity "PrescriptionItem" as PrescriptionItem {
    * id : String <<PK>>
    --
    prescriptionId : String <<FK>>
    medicationName : String
    dosage : String
    quantity : Int
    unit : String
    route : String
    usageInstructions : String
    createdAt : DateTime
}

MedicalEncounter ||--o{ Diagnosis : "ghi nhận chẩn đoán ICD-10"
MedicalEncounter ||--o{ Observation : "đo lường sinh hiệu & cận lâm sàng"
MedicalEncounter ||--o{ Prescription : "kê đơn thuốc điện tử"
Prescription ||--o{ PrescriptionItem : "chi tiết từng thuốc trong đơn"

@enduml

