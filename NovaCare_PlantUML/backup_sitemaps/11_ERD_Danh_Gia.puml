@startuml 11_ERD_Danh_Gia
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #000000

skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam ArrowThickness 1

skinparam ClassBackgroundColor #87CEEB
skinparam ClassHeaderBackgroundColor #87CEEB
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 1
skinparam ClassFontColor #000000
skinparam ClassFontSize 12
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #000000
skinparam ClassAttributeFontSize 11
skinparam ClassAttributeFontName Arial

skinparam EntityBackgroundColor #87CEEB
skinparam EntityHeaderBackgroundColor #87CEEB
skinparam EntityBorderColor #000000
skinparam EntityBorderThickness 1
skinparam EntityFontColor #000000
skinparam EntityFontSize 12
skinparam EntityFontStyle bold
skinparam EntityAttributeFontColor #000000
skinparam EntityAttributeFontSize 11
skinparam EntityAttributeFontName Arial

skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
skinparam packageBorderThickness 1
skinparam packageFontColor #000000
skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam packageStyle rectangle

skinparam nodesep 50
skinparam ranksep 50
skinparam linetype ortho

hide circle

title ERD PHÂN HỆ ĐÁNH GIÁ & KIỂM DUYỆT CHẤT LƯỢNG (5 THỰC THỂ)

entity "Review" as Review {
    * id : String <<PK>>
    --
    appointmentId : String <<PK,FK,UK>>
    userId : String <<FK>>
    targetType : ReviewTargetType
    targetId : String
    rating : Int
    comment : String
    status : ReviewStatus
    isAnonymous : Boolean
    createdAt : DateTime
    updatedAt : DateTime
}

entity "ReviewCriteriaScore" as ReviewCriteriaScore {
    * id : String <<PK>>
    --
    reviewId : String <<PK,FK,UK>>
    doctorAttitude : Int
    examinationQuality : Int
    hospitalWaitingTime : Int
    hospitalStaffAttitude : Int
    hospitalCleanliness : Int
    hospitalReception : Int
    createdAt : DateTime
}

entity "ReviewResponse" as ReviewResponse {
    * id : String <<PK>>
    --
    reviewId : String <<FK>>
    responderId : String <<FK>>
    content : String
    responderRole : String
    createdAt : DateTime
    updatedAt : DateTime
}

entity "ReviewModerationLog" as ReviewModerationLog {
    * id : String <<PK>>
    --
    reviewId : String <<FK>>
    moderatorId : String <<FK>>
    action : String
    reason : String
    createdAt : DateTime
}

entity "ReviewReport" as ReviewReport {
    * id : String <<PK>>
    --
    reviewId : String <<FK>>
    reporterId : String <<FK>>
    reason : ReportReason
    description : String
    isResolved : Boolean
    resolvedAt : DateTime
    createdAt : DateTime
}

Review ||--|| ReviewCriteriaScore : "chi tiết điểm tiêu chí (1-1)"
Review ||--o{ ReviewResponse : "phản hồi chính thức"
Review ||--o{ ReviewModerationLog : "nhật ký kiểm duyệt admin"
Review ||--o{ ReviewReport : "báo cáo vi phạm từ cộng đồng"

@enduml

