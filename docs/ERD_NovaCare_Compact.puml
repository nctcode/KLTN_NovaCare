@startuml
!theme plain
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 4
skinparam nodesep 30
skinparam ranksep 35
skinparam EntityFontSize 11
skinparam EntityAttributeFontSize 10
hide circle

title SƠ ĐỒ THỰC THỂ LIÊN KẾT (ERD) - HỆ THỐNG NOVACARE (51 THỰC THỂ)

' ==========================================
' 1. USER & AUTH
' ==========================================
entity "User" as U {
  * id : String <<PK>>
  --
  email : String
  phone : String
  fullName : String
  role : Role
  hospitalId : String <<FK>>
  isActive : Boolean
}

entity "RefreshToken" as RT {
  * id : String <<PK>>
  --
  userId : String <<FK>>
  tokenHash : String
  expiresAt : DateTime
}

entity "PasswordResetChallenge" as PRC {
  * userId : String <<PK>>
  --
  otpHash : String
  destination : String
  expiresAt : DateTime
}

entity "RegistrationOtpChallenge" as ROC {
  * phone : String <<PK>>
  --
  otpHash : String
  expiresAt : DateTime
}

entity "DeviceToken" as DT {
  * id : String <<PK>>
  --
  userId : String <<FK>>
  deviceToken : String
  deviceType : String
}

entity "AuditLog" as AL {
  * id : String <<PK>>
  --
  userId : String <<FK>>
  action : String
  entityType : String
  entityId : String
}

entity "Notification" as NF {
  * id : String <<PK>>
  --
  userId : String <<FK>>
  title : String
  type : NotificationType
  isRead : Boolean
}

entity "NotificationLog" as NL {
  * id : String <<PK>>
  --
  appointmentId : String
  userId : String
  channel : String
  status : String
}

' ==========================================
' 2. PATIENT & MEDICAL PASSPORT
' ==========================================
entity "PatientProfile" as PP {
  * id : String <<PK>>
  --
  userId : String <<FK>>
  fullName : String
  gender : Gender
  dateOfBirth : DateTime
  phone : String
  isDefault : Boolean
}

entity "MedicalPassport" as MP {
  * id : String <<PK>>
  --
  userId : String <<FK>>
  summary : Json
  version : Int
}

entity "MedicalPassportShare" as MPS {
  * id : String <<PK>>
  --
  passportId : String <<FK>>
  shareToken : String
  validUntil : DateTime
  isActive : Boolean
}

entity "MedicalPassportAccessLog" as MPAL {
  * id : String <<PK>>
  --
  shareId : String <<FK>>
  ipAddress : String
  accessedAt : DateTime
}

entity "PatientConsent" as PC {
  * id : String <<PK>>
  --
  patientProfileId : String <<FK>>
  sourceHospitalId : String <<FK>>
  targetHospitalId : String <<FK>>
  status : ConsentStatus
}

entity "PatientHospitalLink" as PHL {
  * id : String <<PK>>
  --
  patientProfileId : String <<FK>>
  hospitalId : String <<FK>>
  externalPatientId : String
  matchingStatus : MatchingStatus
}

' ==========================================
' 3. HOSPITAL & CATALOG
' ==========================================
entity "Hospital" as H {
  * id : String <<PK>>
  --
  name : String
  address : String
  hospitalType : HospitalType
  partnershipStatus : PartnershipStatus
  isVerified : Boolean
}

entity "HospitalBookingConfig" as HBC {
  * id : String <<PK>>
  --
  hospitalId : String <<FK>>
  bookingType : BookingType
  maxAdvanceDays : Int
  scheduleSource : ScheduleSource
}

entity "HospitalBranch" as HB {
  * id : String <<PK>>
  --
  hospitalId : String <<FK>>
  name : String
  address : String
  isActive : Boolean
}

entity "Specialty" as S {
  * id : String <<PK>>
  --
  name : String
  icon : String
  isActive : Boolean
}

entity "HospitalSpecialty" as HS {
  * id : String <<PK>>
  --
  hospitalId : String <<FK>>
  specialtyId : String <<FK>>
  isActive : Boolean
}

entity "MedicalService" as MS {
  * id : String <<PK>>
  --
  hospitalId : String <<FK>>
  specialtyId : String <<FK>>
  name : String
  price : Decimal
  duration : Int
}

entity "ClinicRoom" as CR {
  * id : String <<PK>>
  --
  hospitalId : String
  code : String
  name : String
}

entity "ClinicRoomSession" as CRS {
  * id : String <<PK>>
  --
  roomId : String <<FK>>
  medicalServiceId : String <<FK>>
  slotId : String <<FK>>
  mode : String
}

entity "HealthPackage" as HP {
  * id : String <<PK>>
  --
  hospitalId : String <<FK>>
  specialtyId : String <<FK>>
  name : String
  price : Decimal
}

entity "PartnerRequest" as PR {
  * id : String <<PK>>
  --
  type : PartnerType
  contactName : String
  hospitalName : String
  status : PartnerRequestStatus
}

' ==========================================
' 4. DOCTOR & SCHEDULE
' ==========================================
entity "Doctor" as D {
  * id : String <<PK>>
  --
  userId : String <<FK>>
  fullName : String
  qualification : String
  yearsOfExperience : Int
  isActive : Boolean
}

entity "DoctorWorkplace" as DW {
  * id : String <<PK>>
  --
  doctorId : String <<FK>>
  hospitalId : String <<FK>>
  branchId : String <<FK>>
  specialtyId : String <<FK>>
  consultationFee : Decimal
}

entity "DoctorSchedule" as DS {
  * id : String <<PK>>
  --
  doctorWorkplaceId : String <<FK>>
  dayOfWeek : Int
  startTime : String
  endTime : String
  slotDuration : Int
}

entity "DoctorScheduleService" as DSS {
  * id : String <<PK>>
  --
  scheduleId : String <<FK>>
  medicalServiceId : String <<FK>>
}

entity "ScheduleException" as SE {
  * id : String <<PK>>
  --
  doctorWorkplaceId : String <<FK>>
  date : DateTime
  exceptionType : ScheduleExceptionType
  reason : String
}

' ==========================================
' 5. APPOINTMENT SLOT & BOOKING & PAYMENT
' ==========================================
entity "AppointmentSlot" as AS {
  * id : String <<PK>>
  --
  doctorWorkplaceId : String <<FK>>
  date : DateTime
  startTime : DateTime
  endTime : DateTime
  capacity : Int
  bookedCount : Int
  isAvailable : Boolean
}

entity "AppointmentSlotBooking" as ASB {
  * id : String <<PK>>
  --
  appointmentId : String <<FK>>
  slotId : String <<FK>>
}

entity "Appointment" as A {
  * id : String <<PK>>
  --
  bookingCode : String
  patientProfileId : String <<FK>>
  slotId : String <<FK>>
  medicalServiceId : String <<FK>>
  userId : String <<FK>>
  status : AppointmentStatus
  bookingType : BookingType
  totalPrice : Decimal
  qrCode : String
}

entity "AppointmentStatusHistory" as ASH {
  * id : String <<PK>>
  --
  appointmentId : String <<FK>>
  status : AppointmentStatus
  note : String
}

entity "AppointmentContactLog" as ACL {
  * id : String <<PK>>
  --
  appointmentId : String <<FK>>
  channel : String
  outcome : String
}

entity "PaymentTransaction" as PT {
  * id : String <<PK>>
  --
  appointmentId : String <<FK>>
  amount : Decimal
  paymentMethod : PaymentMethod
  transactionCode : String
  status : PaymentStatus
}

' ==========================================
' 6. PRE-EXAM AI SCREENING & PPG
' ==========================================
entity "PreExamSession" as PES {
  * id : String <<PK>>
  --
  userId : String <<FK>>
  status : String
  initialText : String
  voiceTranscript : String
  riskLevel : String
  recommendations : Json
}

entity "PreExamQuestion" as PEQ {
  * id : String <<PK>>
  --
  sessionId : String <<FK>>
  question : String
  answer : String
}

entity "ScreeningMedia" as SM {
  * id : String <<PK>>
  --
  sessionId : String <<FK>>
  type : String
  storageKey : String
  mimeType : String
  processingStatus : String
}

' ==========================================
' 7. TELEMEDICINE CONSULTATION
' ==========================================
entity "ConsultationSession" as CS {
  * id : String <<PK>>
  --
  patientProfileId : String <<FK>>
  doctorId : String <<FK>>
  doctorWorkplaceId : String <<FK>>
  specialtyId : String <<FK>>
  appointmentId : String <<FK>>
  createdByUserId : String <<FK>>
  channel : ConsultationChannel
  status : ConsultationStatus
}

entity "ConsultationMessage" as CM {
  * id : String <<PK>>
  --
  consultationId : String <<FK>>
  senderUserId : String <<FK>>
  senderType : ConsultationSenderType
  messageType : ConsultationMessageType
  text : String
}

entity "ConsultationAttachment" as CA {
  * id : String <<PK>>
  --
  consultationId : String <<FK>>
  messageId : String <<FK>>
  uploadedByUserId : String <<FK>>
  fileName : String
  mimeType : String
}

' ==========================================
' 8. CLINICAL ENCOUNTER & PRESCRIPTION
' ==========================================
entity "MedicalEncounter" as ME {
  * id : String <<PK>>
  --
  patientProfileId : String <<FK>>
  hospitalId : String <<FK>>
  appointmentId : String <<FK>>
  encounterCode : String
  encounterDate : DateTime
  status : EncounterStatus
}

entity "Diagnosis" as DG {
  * id : String <<PK>>
  --
  encounterId : String <<FK>>
  icdCode : String
  diseaseName : String
  isPrimary : Boolean
}

entity "Observation" as OB {
  * id : String <<PK>>
  --
  encounterId : String <<FK>>
  category : ObservationCategory
  name : String
  value : String
  unit : String
}

entity "Prescription" as RX {
  * id : String <<PK>>
  --
  encounterId : String <<FK>>
  prescriptionCode : String
  prescribedAt : DateTime
}

entity "PrescriptionItem" as RXI {
  * id : String <<PK>>
  --
  prescriptionId : String <<FK>>
  drugName : String
  dosage : String
  quantity : Int
}

' ==========================================
' 9. REVIEW & MODERATION
' ==========================================
entity "Review" as RV {
  * id : String <<PK>>
  --
  appointmentId : String <<FK>>
  userId : String <<FK>>
  doctorId : String <<FK>>
  hospitalId : String <<FK>>
  targetType : ReviewTargetType
  rating : Int
  status : ReviewStatus
}

entity "ReviewCriteriaScore" as RCS {
  * id : String <<PK>>
  --
  reviewId : String <<FK>>
  doctorAttitude : Int
  hospitalFacility : Int
}

entity "ReviewResponse" as RR {
  * id : String <<PK>>
  --
  reviewId : String <<FK>>
  responderId : String <<FK>>
  responseContent : String
}

entity "ReviewModerationLog" as RML {
  * id : String <<PK>>
  --
  reviewId : String <<FK>>
  newStatus : ReviewStatus
  reason : String
}

entity "ReviewReport" as RRP {
  * id : String <<PK>>
  --
  reviewId : String <<FK>>
  reporterId : String
  reason : ReportReason
  isResolved : Boolean
}

' ==========================================
' RELATIONSHIPS
' ==========================================

' --- User & Auth ---
H ||--o{ U
U ||--o{ RT
U ||--o{ DT
U ||--o{ AL
U ||--o{ NF

' --- Patient ---
U ||--o{ PP
U ||--o{ MP
MP ||--o{ MPS
MPS ||--o{ MPAL
PP ||--o{ PC
H ||--o{ PC
PP ||--o{ PHL
H ||--o{ PHL

' --- Hospital & Catalog ---
H ||--o{ HBC
H ||--o{ HB
H ||--o{ HS
S ||--o{ HS
H ||--o{ MS
S ||--o{ MS
CR ||--o{ CRS
MS ||--o{ CRS
AS ||--o{ CRS
H ||--o{ HP
S ||--o{ HP

' --- Doctor & Schedule ---
U ||--o| D
D ||--o{ DW
H ||--o{ DW
HB ||--o{ DW
S ||--o{ DW
DW ||--o{ DS
DS ||--o{ DSS
MS ||--o{ DSS
DW ||--o{ SE

' --- Slot & Appointment & Payment ---
DW ||--o{ AS
A ||--o{ ASB
AS ||--o{ ASB
PP ||--o{ A
U ||--o{ A
AS ||--o{ A
MS ||--o{ A
A ||--o{ ASH
A ||--o{ ACL
A ||--o{ PT

' --- Pre-Exam AI ---
U ||--o{ PES
PES ||--o{ PEQ
PES ||--o{ SM

' --- Telemedicine ---
PP ||--o{ CS
D ||--o{ CS
DW ||--o{ CS
S ||--o{ CS
A ||--o| CS
U ||--o{ CS
CS ||--o{ CM
U ||--o{ CM
CS ||--o{ CA
CM ||--o{ CA
U ||--o{ CA

' --- Clinical ---
PP ||--o{ ME
H ||--o{ ME
A ||--o| ME
ME ||--o{ DG
ME ||--o{ OB
ME ||--o{ RX
RX ||--o{ RXI

' --- Review ---
A ||--o{ RV
U ||--o{ RV
D ||--o{ RV
H ||--o{ RV
RV ||--o{ RCS
RV ||--o{ RR
U ||--o{ RR
RV ||--o{ RML
RV ||--o{ RRP

@enduml

