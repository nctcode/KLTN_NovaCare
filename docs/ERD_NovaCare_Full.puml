@startuml
!theme plain
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 5
skinparam packageStyle rectangle
skinparam nodesep 50
skinparam ranksep 60
title SƠ ĐỒ THỰC THỂ LIÊN KẾT (FULL ERD) - NỀN TẢNG Y TẾ SỐ NOVACARE (TOÀN BỘ 51 THỰC THỂ)

package "Phân hệ Tài khoản, Xác thực & Phân quyền" {
  entity "User" as User {
    * id : String <<PK>>
    --
    authVersion : Int
    email : String?
    phone : String?
    passwordHash : String
    fullName : String
    role : Role
    isActive : Boolean
    lastLoginAt : DateTime?
    ... (11 thuộc tính khác)
  }

  entity "RefreshToken" as RefreshToken {
    * id : String <<PK>>
    --
    userId : String <<FK>>
    tokenHash : String
    expiresAt : DateTime
    deviceInfo : String?
    ipAddress : String?
    isRevoked : Boolean
    createdAt : DateTime
    updatedAt : DateTime
  }

  entity "PasswordResetChallenge" as PasswordResetChallenge {
    * userId : String <<PK>>
    --
    otpHash : String?
    destination : String
    expiresAt : DateTime
    requestedAt : DateTime
    attempts : Int
    windowStart : DateTime
    sendCount : Int
    verificationTokenHash : String?
    verificationExpiresAt : DateTime?
  }

  entity "RegistrationOtpChallenge" as RegistrationOtpChallenge {
    * phone : String <<PK>>
    --
    otpHash : String?
    expiresAt : DateTime
    requestedAt : DateTime
    attempts : Int
    windowStart : DateTime
    sendCount : Int
    verificationTokenHash : String?
    verificationExpiresAt : DateTime?
  }

  entity "DeviceToken" as DeviceToken {
    * id : String <<PK>>
    --
    userId : String <<FK>>
    deviceToken : String
    deviceType : String
    isActive : Boolean
    createdAt : DateTime
    updatedAt : DateTime
  }

  entity "AuditLog" as AuditLog {
    * id : String <<PK>>
    --
    userId : String <<FK>>
    action : String
    entityType : String
    entityId : String?
    oldValue : Json?
    newValue : Json?
    ipAddress : String?
    userAgent : String?
    createdAt : DateTime
  }

  entity "Notification" as Notification {
    * id : String <<PK>>
    --
    userId : String <<FK>>
    title : String
    content : String
    type : NotificationType
    isRead : Boolean
    readAt : DateTime?
    data : Json?
    channel : String?
    ... (3 thuộc tính khác)
  }

  entity "NotificationLog" as NotificationLog {
    * id : String <<PK>>
    --
    appointmentId : String?
    userId : String
    type : String
    channel : String
    status : String
    errorMessage : String?
    sentAt : DateTime?
    createdAt : DateTime
  }

}

package "Phân hệ Hồ sơ Người bệnh & Hộ chiếu Y tế" {
  entity "PatientProfile" as PatientProfile {
    * id : String <<PK>>
    --
    patientCode : String?
    userId : String <<FK>>
    fullName : String
    gender : Gender?
    dateOfBirth : DateTime?
    phone : String?
    address : String?
    relation : String?
    ... (26 thuộc tính khác)
  }

  entity "MedicalPassport" as MedicalPassport {
    * id : String <<PK>>
    --
    userId : String <<FK>>
    summary : Json
    version : Int
    updatedAt : DateTime
  }

  entity "MedicalPassportShare" as MedicalPassportShare {
    * id : String <<PK>>
    --
    passportId : String <<FK>>
    shareToken : String
    qrCode : String
    pinCode : String?
    allowedSections : String[]
    validUntil : DateTime
    isActive : Boolean
    lastAccessedAt : DateTime?
    ... (4 thuộc tính khác)
  }

  entity "MedicalPassportAccessLog" as MedicalPassportAccessLog {
    * id : String <<PK>>
    --
    shareId : String <<FK>>
    ipAddress : String?
    userAgent : String?
    accessedAt : DateTime
  }

  entity "PatientConsent" as PatientConsent {
    * id : String <<PK>>
    --
    patientProfileId : String <<FK>>
    sourceHospitalId : String <<FK>>
    targetHospitalId : String <<FK>>
    status : ConsentStatus
    grantedAt : DateTime?
    expiresAt : DateTime?
    revokedAt : DateTime?
    scope : Json?
    ... (5 thuộc tính khác)
  }

  entity "PatientHospitalLink" as PatientHospitalLink {
    * id : String <<PK>>
    --
    patientProfileId : String <<FK>>
    hospitalId : String <<FK>>
    externalPatientId : String
    matchingStatus : MatchingStatus
    createdAt : DateTime
    updatedAt : DateTime
  }

}

package "Phân hệ Cơ sở Y tế, Chuyên khoa & Dịch vụ" {
  entity "Hospital" as Hospital {
    * id : String <<PK>>
    --
    name : String
    address : String?
    city : String?
    phone : String?
    hotline : String?
    emergencyHotline : String?
    description : String?
    logoUrl : String?
    ... (21 thuộc tính khác)
  }

  entity "HospitalBookingConfig" as HospitalBookingConfig {
    * id : String <<PK>>
    --
    hospitalId : String <<FK>>
    bookingType : BookingType
    maxAdvanceDays : Int
    allowSaturday : Boolean
    allowSunday : Boolean
    minAdvanceMinutes : Int
    defaultSlotDuration : Int
    scheduleSource : ScheduleSource
    ... (6 thuộc tính khác)
  }

  entity "HospitalBranch" as HospitalBranch {
    * id : String <<PK>>
    --
    hospitalId : String <<FK>>
    name : String?
    address : String
    phone : String?
    latitude : Float?
    longitude : Float?
    isActive : Boolean
    createdAt : DateTime
    updatedAt : DateTime
    deletedAt : DateTime?
  }

  entity "Specialty" as Specialty {
    * id : String <<PK>>
    --
    name : String
    description : String?
    icon : String?
    coverImageUrl : String?
    isActive : Boolean
    createdAt : DateTime
    updatedAt : DateTime
  }

  entity "HospitalSpecialty" as HospitalSpecialty {
    * id : String <<PK>>
    --
    hospitalId : String <<FK>>
    specialtyId : String <<FK>>
    isActive : Boolean
    createdAt : DateTime
    updatedAt : DateTime
  }

  entity "MedicalService" as MedicalService {
    * id : String <<PK>>
    --
    hospitalId : String <<FK>>
    specialtyId : String? <<FK>>
    name : String
    description : String?
    price : Decimal
    duration : Int
    isActive : Boolean
    createdAt : DateTime
    updatedAt : DateTime
  }

  entity "ClinicRoom" as ClinicRoom {
    * id : String <<PK>>
    --
    hospitalId : String
    specialtyId : String
    code : String
    name : String
    isActive : Boolean
  }

  entity "ClinicRoomSession" as ClinicRoomSession {
    * id : String <<PK>>
    --
    roomId : String <<FK>>
    medicalServiceId : String <<FK>>
    slotId : String <<FK>>
    mode : String
  }

  entity "HealthPackage" as HealthPackage {
    * id : String <<PK>>
    --
    hospitalId : String <<FK>>
    specialtyId : String? <<FK>>
    name : String
    thumbnailUrl : String?
    price : Decimal
    originalPrice : Decimal?
    description : String?
    duration : Int
    ... (6 thuộc tính khác)
  }

  entity "PartnerRequest" as PartnerRequest {
    * id : String <<PK>>
    --
    type : PartnerType
    contactName : String
    titleOrRole : String?
    phone : String
    email : String
    hospitalName : String
    specialty : String?
    notes : String?
    ... (7 thuộc tính khác)
  }

}

package "Phân hệ Bác sĩ, Nơi làm việc & Lịch trực" {
  entity "Doctor" as Doctor {
    * id : String <<PK>>
    --
    fullName : String
    title : String?
    avatarUrl : String?
    qualification : String
    yearsOfExperience : Int
    gender : Gender?
    bio : String?
    externalId : String?
    ... (9 thuộc tính khác)
  }

  entity "DoctorWorkplace" as DoctorWorkplace {
    * id : String <<PK>>
    --
    doctorId : String <<FK>>
    hospitalId : String <<FK>>
    branchId : String? <<FK>>
    specialtyId : String <<FK>>
    consultationFee : Decimal
    position : String?
    joinedAt : DateTime?
    isPrimary : Boolean
    ... (3 thuộc tính khác)
  }

  entity "DoctorSchedule" as DoctorSchedule {
    * id : String <<PK>>
    --
    doctorWorkplaceId : String <<FK>>
    bookingType : BookingType
    dayOfWeek : Int
    startTime : String
    endTime : String
    breakStart : String?
    breakEnd : String?
    slotDuration : Int?
    ... (6 thuộc tính khác)
  }

  entity "DoctorScheduleService" as DoctorScheduleService {
    * id : String <<PK>>
    --
    scheduleId : String <<FK>>
    medicalServiceId : String <<FK>>
    createdAt : DateTime
  }

  entity "ScheduleException" as ScheduleException {
    * id : String <<PK>>
    --
    doctorWorkplaceId : String <<FK>>
    date : DateTime
    startTime : String?
    endTime : String?
    exceptionType : ScheduleExceptionType
    reason : String?
    createdAt : DateTime
    updatedAt : DateTime
  }

}

package "Phân hệ Suất khám, Lịch hẹn & Thanh toán" {
  entity "AppointmentSlot" as AppointmentSlot {
    * id : String <<PK>>
    --
    doctorWorkplaceId : String <<FK>>
    date : DateTime?
    startTime : DateTime
    endTime : DateTime
    capacity : Int
    bookedCount : Int
    isAvailable : Boolean
    isActive : Boolean
    ... (4 thuộc tính khác)
  }

  entity "AppointmentSlotBooking" as AppointmentSlotBooking {
    * id : String <<PK>>
    --
    appointmentId : String <<FK>>
    slotId : String <<FK>>
    createdAt : DateTime
  }

  entity "Appointment" as Appointment {
    * id : String <<PK>>
    --
    clinicRoomId : String?
    serviceBookingMode : String?
    bookingCode : String
    patientProfileId : String <<FK>>
    slotId : String <<FK>>
    medicalServiceId : String? <<FK>>
    userId : String <<FK>>
    status : AppointmentStatus
    ... (15 thuộc tính khác)
  }

  entity "AppointmentStatusHistory" as AppointmentStatusHistory {
    * id : String <<PK>>
    --
    appointmentId : String <<FK>>
    status : AppointmentStatus
    note : String?
    createdAt : DateTime
  }

  entity "AppointmentContactLog" as AppointmentContactLog {
    * id : String <<PK>>
    --
    appointmentId : String <<FK>>
    staffId : String?
    staffName : String?
    channel : String
    outcome : String
    note : String?
    contactedAt : DateTime
    createdAt : DateTime
  }

  entity "PaymentTransaction" as PaymentTransaction {
    * id : String <<PK>>
    --
    appointmentId : String <<FK>>
    amount : Decimal
    paymentMethod : PaymentMethod
    transactionCode : String
    status : PaymentStatus
    vnpResponseCode : String?
    vnpTransactionNo : String?
    callbackData : Json?
    ... (3 thuộc tính khác)
  }

}

package "Phân hệ Sàng lọc Tiền khám AI & Sinh hiệu PPG" {
  entity "PreExamSession" as PreExamSession {
    * id : String <<PK>>
    --
    userId : String <<FK>>
    status : String
    startedAt : DateTime
    completedAt : DateTime?
    initialText : String?
    voiceTranscript : String?
    bodyDiagramData : Json?
    imageAnalysis : Json?
    ... (5 thuộc tính khác)
  }

  entity "PreExamQuestion" as PreExamQuestion {
    * id : String <<PK>>
    --
    sessionId : String <<FK>>
    question : String
    answer : String?
    order : Int
    context : Json?
  }

  entity "ScreeningMedia" as ScreeningMedia {
    * id : String <<PK>>
    --
    sessionId : String <<FK>>
    type : String
    storageKey : String
    mimeType : String
    sizeBytes : Int
    durationMs : Int?
    scriptId : String?
    processingStatus : String
    transcript : String?
    createdAt : DateTime
  }

}

package "Phân hệ Khám bệnh Từ xa (Telemedicine)" {
  entity "ConsultationSession" as ConsultationSession {
    * id : String <<PK>>
    --
    patientProfileId : String <<FK>>
    doctorId : String <<FK>>
    doctorWorkplaceId : String <<FK>>
    specialtyId : String <<FK>>
    appointmentId : String? <<FK>>
    createdByUserId : String <<FK>>
    idempotencyKey : String
    requestMode : ConsultationRequestMode
    ... (16 thuộc tính khác)
  }

  entity "ConsultationMessage" as ConsultationMessage {
    * id : String <<PK>>
    --
    consultationId : String <<FK>>
    senderUserId : String <<FK>>
    senderType : ConsultationSenderType
    messageType : ConsultationMessageType
    clientMessageId : String
    text : String?
    sentAt : DateTime
    deliveredAt : DateTime?
    ... (3 thuộc tính khác)
  }

  entity "ConsultationAttachment" as ConsultationAttachment {
    * id : String <<PK>>
    --
    consultationId : String <<FK>>
    messageId : String? <<FK>>
    uploadedByUserId : String <<FK>>
    status : ConsultationAttachmentStatus
    type : ConsultationMessageType
    fileName : String
    mimeType : String
    sizeBytes : Int
    ... (4 thuộc tính khác)
  }

}

package "Phân hệ Hồ sơ Lâm sàng, Chẩn đoán & Đơn thuốc" {
  entity "MedicalEncounter" as MedicalEncounter {
    * id : String <<PK>>
    --
    patientProfileId : String <<FK>>
    hospitalId : String <<FK>>
    appointmentId : String? <<FK>>
    externalEncounterId : String?
    encounterCode : String
    encounterDate : DateTime
    doctorName : String
    doctorTitle : String?
    ... (27 thuộc tính khác)
  }

  entity "Diagnosis" as Diagnosis {
    * id : String <<PK>>
    --
    encounterId : String <<FK>>
    icdCode : String
    diseaseName : String
    isPrimary : Boolean
    isComplication : Boolean
    diagnosisType : String?
    note : String?
    createdAt : DateTime
    updatedAt : DateTime
  }

  entity "Observation" as Observation {
    * id : String <<PK>>
    --
    encounterId : String <<FK>>
    category : ObservationCategory
    code : String?
    name : String
    value : String
    unit : String?
    referenceRange : String?
    interpretation : String?
    ... (3 thuộc tính khác)
  }

  entity "Prescription" as Prescription {
    * id : String <<PK>>
    --
    encounterId : String <<FK>>
    prescriptionCode : String
    prescribedAt : DateTime
    note : String?
    createdAt : DateTime
    updatedAt : DateTime
  }

  entity "PrescriptionItem" as PrescriptionItem {
    * id : String <<PK>>
    --
    prescriptionId : String <<FK>>
    drugName : String
    activeIngredientCode : String?
    dosage : String
    usageInstruction : String
    quantity : Int
    unit : String?
    duration : String?
    ... (3 thuộc tính khác)
  }

}

package "Phân hệ Đánh giá & Kiểm duyệt" {
  entity "Review" as Review {
    * id : String <<PK>>
    --
    appointmentId : String <<FK>>
    userId : String <<FK>>
    targetType : ReviewTargetType
    doctorId : String? <<FK>>
    hospitalId : String? <<FK>>
    rating : Int
    comment : String
    isAnonymous : Boolean
    ... (9 thuộc tính khác)
  }

  entity "ReviewCriteriaScore" as ReviewCriteriaScore {
    * id : String <<PK>>
    --
    reviewId : String <<FK>>
    doctorAttitude : Int?
    doctorExplanation : Int?
    doctorDedication : Int?
    doctorCommunication : Int?
    hospitalFacility : Int?
    hospitalHygiene : Int?
    hospitalReception : Int?
    hospitalWaitingTime : Int?
    hospitalStaffAttitude : Int?
  }

  entity "ReviewResponse" as ReviewResponse {
    * id : String <<PK>>
    --
    reviewId : String <<FK>>
    responderId : String <<FK>>
    responderRole : Role
    responderName : String
    responseContent : String
    createdAt : DateTime
    updatedAt : DateTime
  }

  entity "ReviewModerationLog" as ReviewModerationLog {
    * id : String <<PK>>
    --
    reviewId : String <<FK>>
    adminUserId : String?
    previousStatus : ReviewStatus?
    newStatus : ReviewStatus
    reason : String?
    snapshotContent : Json?
    createdAt : DateTime
  }

  entity "ReviewReport" as ReviewReport {
    * id : String <<PK>>
    --
    reviewId : String <<FK>>
    reporterId : String?
    reason : ReportReason
    description : String?
    isResolved : Boolean
    resolvedAt : DateTime?
    resolvedBy : String?
    createdAt : DateTime
  }

}

