@startuml seq_phan_quyen_gan_vai_tro
skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 2
skinparam participantBorderColor #0f172a
skinparam participantBackgroundColor #7DD3FC
skinparam actorBorderColor #0f172a
skinparam actorBackgroundColor #7DD3FC

title sd Phân quyền và gán vai trò tài khoản (NovaCare)

actor "Quản trị viên hệ thống\n(ADMIN)" as Admin
boundary "GD_PhanQuyenVaiTro" as GD
control "CTR_AdminUsersService" as CTR
entity "ObjUser_new" as ObjUser
entity "E_users" as E_USER
entity "E_audit_logs" as E_AUDIT

activate Admin
Admin -> GD : 1: Truy cập mục "Quản lý vai trò và phân quyền người dùng"
activate GD
GD -> CTR : 1.1: findAll(roles=[HOSPITAL_ADMIN, ADMIN])
activate CTR
CTR -> E_USER : 1.2: findMany(roles, hospital)
activate E_USER
E_USER --> CTR : 1.3: Trả về danh sách tài khoản quản trị & phạm vi cơ sở
deactivate E_USER
CTR --> GD : 1.4: Trả về danh sách tài khoản quản trị
deactivate CTR
GD --> Admin : 1.5: Hiển thị Tab "Ma trận phân quyền (RBAC)", Tab "Tài khoản quản trị & Phạm vi cơ sở"\nvà nút "Cấp tài khoản quản trị cơ sở"

alt Chọn "Cấp tài khoản quản trị cơ sở" (HOSPITAL_ADMIN)
  Admin -> GD : 2: Chọn cơ sở y tế, nhập họ tên, email và nhấn "Cấp tài khoản & gửi email"
  GD -> CTR : 2.1: createHospitalAdmin(hospitalId, fullName, email)
  activate CTR
  CTR -> E_USER : 2.2: validateHospitalAndEmail(hospitalId, email)
  activate E_USER
  E_USER --> CTR : 2.3: Trả về kết quả kiểm tra cơ sở y tế & email
  deactivate E_USER

  alt Cơ sở y tế đang hợp tác và email chưa tồn tại trong hệ thống
    CTR --> ObjUser ** : 2.4: <<create>> CreateObjUser_new
    activate ObjUser
    ObjUser --> CTR : 2.5: Trả về ObjUser_new
    deactivate ObjUser

    CTR -> E_USER : 2.6: create(ObjUser_new)
    activate E_USER
    E_USER -> E_USER : 2.7: Lưu tài khoản chờ kích hoạt
    destroy ObjUser
    E_USER --> CTR : 2.8: Trả về tài khoản mới tạo
    deactivate E_USER

    CTR -> CTR : 2.9: sendHospitalActivationEmail(email, activationUrl)

    CTR -> E_AUDIT : 2.10: logAction(CREATE_HOSPITAL_ADMIN, userId)
    activate E_AUDIT
    E_AUDIT -> E_AUDIT : 2.11: Ghi nhật ký thao tác
    E_AUDIT --> CTR : 2.12: Hoàn tất ghi nhật ký
    deactivate E_AUDIT

    CTR --> GD : 2.13: Trả về kết quả cấp tài khoản & gửi email thành công
    GD --> Admin : 2.14: Đóng hộp thoại, hiển thị thông báo thành công và làm mới danh sách tài khoản quản trị
  else Email đã tồn tại trong hệ thống hoặc cơ sở y tế đã ngừng hợp tác (Alt 3.1, 4.1)
    CTR --> GD : 2.15: Trả về lỗi kiểm tra (409 Conflict / 400 Bad Request)
    deactivate CTR
    GD --> Admin : 2.16: Giữ nguyên hộp thoại và hiển thị thông báo lỗi tương ứng
  end
else Chọn "Điều chuyển cơ sở" tại Tab "Tài khoản quản trị & Phạm vi cơ sở"
  Admin -> GD : 3: Chọn tài khoản HOSPITAL_ADMIN, nhấn "Điều chuyển cơ sở",\nchọn cơ sở mới và nhấn "Xác nhận điều chuyển"
  GD -> CTR : 3.1: updateRole(userId, HOSPITAL_ADMIN, newHospitalId)
  activate CTR
  CTR -> E_USER : 3.2: validateScopeTransfer(userId, newHospitalId)
  activate E_USER
  E_USER --> CTR : 3.3: Trả về kết quả kiểm tra tài khoản & cơ sở mới
  deactivate E_USER

  alt Đúng tài khoản HOSPITAL_ADMIN, cơ sở mới đang hợp tác và khác cơ sở hiện tại
    CTR -> E_USER : 3.4: update(userId, newHospitalId, authVersion + 1)
    activate E_USER
    E_USER -> E_USER : 3.5: Cập nhật cơ sở & thu hồi phiên cũ
    E_USER --> CTR : 3.6: Trả về tài khoản đã điều chuyển
    deactivate E_USER

    CTR -> E_AUDIT : 3.7: logAction(UPDATE_USER_ROLE, userId)
    activate E_AUDIT
    E_AUDIT -> E_AUDIT : 3.8: Ghi nhật ký điều chuyển
    E_AUDIT --> CTR : 3.9: Hoàn tất ghi nhật ký
    deactivate E_AUDIT

    CTR --> GD : 3.10: Trả về kết quả điều chuyển cơ sở thành công
    GD --> Admin : 3.11: Đóng hộp thoại, hiển thị thông báo thành công và làm mới danh sách tài khoản quản trị
  else Cơ sở y tế đã ngừng hợp tác hoặc điều kiện không hợp lệ (Alt 3.1, 4.1)
    CTR --> GD : 3.12: Trả về lỗi kiểm tra (400 Bad Request)
    deactivate CTR
    GD --> Admin : 3.13: Giữ nguyên hộp thoại và hiển thị thông báo lỗi tương ứng
  end
end

deactivate GD
deactivate Admin
@enduml
