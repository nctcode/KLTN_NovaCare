@startuml
title sd Tư vấn trực tuyến (NovaCare)
skinparam shadowing false
skinparam sequenceArrowThickness 1.5
skinparam participantFontStyle bold

actor "Bệnh nhân\n(PATIENT)" as Patient
boundary "GD_TuVanVideo" as UI
control "CTR_ConsultationsService" as ConsultCtrl
control "CTR_ConsultationVideoService" as VideoCtrl
entity "E_consultation_sessions" as Sess
actor "Hệ thống LiveKit\n(RoomServiceClient)" as LiveKit
actor "Bác sĩ\n(DOCTOR)" as Doctor

activate Patient
Patient -> UI : 1: Chọn "Lịch gọi video"
activate UI
UI -> ConsultCtrl : 1.1: findAll(userId)
activate ConsultCtrl
ConsultCtrl -> Sess : 1.2: findMany({ where: { patientProfile.userId: userId } })
activate Sess
Sess --> ConsultCtrl : 1.3: consultationSessions[]
deactivate Sess

alt tải danh sách phiên tư vấn thành công
  ConsultCtrl --> UI : 1.4: Hiển thị danh sách phiên tư vấn video
  deactivate ConsultCtrl
else không tải được danh sách phiên tư vấn (Alt 2.1)
  UI --> Patient : 1.5: Báo lỗi & nút "Thử lại" (quay lại bước 2)
end

Patient -> UI : 2: Chọn phiên tư vấn (id)
UI -> ConsultCtrl : 2.1: findOne(id, userId) & listMessages(id)
activate ConsultCtrl
ConsultCtrl -> Sess : 2.2: findUnique({ id, include: { appointment, messages } })
activate Sess
Sess --> ConsultCtrl : 2.3: session, messages[]
deactivate Sess

alt session.status in { "ACCEPTED", "ACTIVE" }
  ConsultCtrl --> UI : 2.4: Hiển thị chi tiết phiên, nội dung trò chuyện & nút "Tham gia video"
  deactivate ConsultCtrl
else chưa tiếp nhận / đã hoàn thành / bị hủy / hết hạn (Alt 4.1)
  UI --> Patient : 2.5: Ẩn nút "Tham gia video" hoặc từ chối mở phòng (quay lại bước 3)
end

Patient -> UI : 3: Nhấn "Tham gia video"
UI -> UI : 3.1: checkCameraAndMicPermissions()
Patient -> UI : 4: Cấp quyền camera & micro (nếu từ chối -> báo vào Cài đặt - Alt 7.1)

UI -> VideoCtrl : 4.1: join(id, userId)
activate VideoCtrl
VideoCtrl -> Sess : 4.2: authorize(id, userId)
activate Sess
Sess --> VideoCtrl : 4.3: session, appointment
deactivate Sess
VideoCtrl -> VideoCtrl : 4.4: requireConfigured() & checkRole/Schedule/AppointmentStatus

alt hợp lệ: đúng user, ACCEPTED/ACTIVE, appointment CONFIRMED/PAID, đúng giờ & LiveKit sẵn sàng
  VideoCtrl -> LiveKit : 4.5: createRoom({ name: "novacare-consultation-" + id, maxParticipants: 2 })
  activate LiveKit
  alt tạo/mở phòng thành công && cấp AccessToken
    LiveKit --> VideoCtrl : 4.6: roomCreated, AccessToken(jwt)
    deactivate LiveKit
    VideoCtrl --> UI : 4.7: { serverUrl, participantToken, roomName, endsAt }
  else không thể tạo phòng hoặc cấp token (Alt 10.1)
    UI --> Patient : 4.8: Thông báo không thể kết nối dịch vụ video + "Thử lại" (quay lại bước 5)
  end
else không có quyền (8.1) | sai giờ/trạng thái phiên (8.2) | lịch chưa xác nhận/thanh toán (8.3) | chưa cấu hình video (9.1)
  VideoCtrl --> UI : 4.9: ForbiddenException (8.1) / BadRequestException (8.2, 8.3) / ServiceUnavailableException (9.1)
  deactivate VideoCtrl
  UI --> Patient : 4.10: Hiển thị thông báo từ chối tương ứng (8.1: kết thúc UC; 8.2/8.3/9.1: quay lại bước 3)
end

UI -> LiveKit : 5: connect(serverUrl, participantToken) & bật camera, micro (lỗi -> báo kiểm tra thiết bị/mạng - Alt 11.1)
activate LiveKit
LiveKit --> UI : 5.1: Connected (hiển thị giao diện cuộc gọi)

activate Doctor
Doctor -> LiveKit : 6: Tham gia phòng video

alt bác sĩ đã tham gia phòng video
  LiveKit --> UI : 6.1: participant_joined -> hiển thị hình ảnh bác sĩ & khung hình bệnh nhân
else bác sĩ chưa tham gia phòng video (Alt 12.1)
  UI --> Patient : 6.2: Hiển thị trạng thái chờ bác sĩ (tiếp tục chờ hoặc kết thúc)
end

Patient -> LiveKit : 7: Trao đổi video/audio (bật/tắt mic, camera, đổi camera, chọn loa, mở trò chuyện)
Doctor -> LiveKit : 7.1: Thực hiện tư vấn

opt sự cố kết nối mạng (Alt 14.1, 14.2) hoặc đưa ứng dụng xuống nền (Alt 14.3)
  UI --> Patient : 7.2: Hiển thị "Đang kết nối lại" (14.1) -> nếu thất bại báo lỗi & cho tham gia lại (14.2)
else đưa ứng dụng xuống nền trong khi gọi (Alt 14.3)
  UI -> LiveKit : 7.3: disconnect() tự động ngắt phòng (mở lại app quay lại bước 5 nếu phiên còn hiệu lực)
end

alt bác sĩ kết thúc / hoàn thành phiên tư vấn (Alt 15.1)
  Doctor -> ConsultCtrl : 8: complete(id, doctorUserId)
  activate ConsultCtrl
  ConsultCtrl -> VideoCtrl : 8.1: close(id)
  activate VideoCtrl
  VideoCtrl -> LiveKit : 8.2: deleteRoom(roomName) -> đóng phòng & báo phiên kết thúc
  deactivate VideoCtrl
  deactivate ConsultCtrl
else bệnh nhân chọn kết thúc cuộc gọi (Steps 16-19)
  Patient -> UI : 9: Chọn kết thúc cuộc gọi
  UI -> UI : 9.1: showConfirmEndCallDialog()
  Patient -> UI : 10: Xác nhận kết thúc (nếu chọn tiếp tục -> quay lại bước 14 - Alt 18.1)
  UI -> LiveKit : 10.1: disconnect() (không tự động hoàn thành consultation_sessions)
  deactivate LiveKit
  UI --> Patient : 10.2: Quay lại màn hình chi tiết phiên tư vấn
end
deactivate Doctor
deactivate UI
deactivate Patient
@enduml
