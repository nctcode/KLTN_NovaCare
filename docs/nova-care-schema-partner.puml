package "Enums" {
  enum PartnerRequestStatus {
    PENDING
    CONTACTED
    APPROVED
    REJECTED
  }
  enum PartnerType {
    HOSPITAL
    DOCTOR
  }
}

package "Partner Management" {
  class PartnerRequest {
    +id: String <<PK>>
    +type: PartnerType
    +contactName: String
    +titleOrRole: String?
    +phone: String
    +email: String
    +hospitalName: String
    +specialty: String?
    +notes: String?
    +status: PartnerRequestStatus
    +adminNote: String?
    +approvedAt: DateTime?
    +createdHospitalId: String?
    +createdUserId: String?
    +createdAt: DateTime
    +updatedAt: DateTime
  }
}


@enduml
