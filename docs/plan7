3. MODULE THANH TOÁN (PAYMENT)
3.1. Tạo yêu cầu thanh toán VNPay
File: src/modules/payments/payments.service.ts
typescript
import { Injectable, BadRequestException } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import * as crypto from 'crypto';
import { PrismaService } from '@/database/prisma.service';
@Injectable()
export class PaymentsService {
  constructor(
    private configService: ConfigService,
    private prisma: PrismaService,
  ) {}
  async createPaymentUrl(appointmentId: string, ipAddress: string): Promise<string> {
    const appointment = await this.prisma.appointment.findUnique({
      where: { id: appointmentId },
      include: { patientProfile: true },
    });
    if (!appointment) throw new BadRequestException('Lịch khám không tồn tại');
    if (appointment.status !== 'AWAITING_PAYMENT') {
      throw new BadRequestException('Lịch khám không ở trạng thái chờ thanh toán');
    }
    // Tạo mã giao dịch duy nhất
    const transactionCode = `NOVA${Date.now()}`;
    const vnpParams: any = {
      vnp_Version: '2.1.0',
      vnp_Command: 'pay',
      vnp_TmnCode: this.configService.get('VNP_TMN_CODE'),
      vnp_Amount: Math.round(Number(appointment.totalPrice) * 100),
      vnp_CurrCode: 'VND',
      vnp_TxnRef: transactionCode,
      vnp_OrderInfo: `Thanh toan lich kham ${appointment.bookingCode}`,
      vnp_OrderType: 'billpayment',
      vnp_Locale: 'vn',
      vnp_ReturnUrl: this.configService.get('VNP_RETURN_URL'),
      vnp_IpAddr: ipAddress,
      vnp_CreateDate: new Date().toISOString().replace(/[-:T.Z]/g, '').slice(0, 14),
    };
    // Sắp xếp tham số
    const sortedKeys = Object.keys(vnpParams).sort();
    const signData = sortedKeys.map(key => `${key}=${vnpParams[key]}`).join('&');
    const secretKey = this.configService.get('VNP_HASH_SECRET');
    const secureHash = crypto.createHmac('sha512', secretKey).update(signData).digest('hex');
    vnpParams.vnp_SecureHash = secureHash;
    // Lưu giao dịch
    await this.prisma.paymentTransaction.create({
      data: {
        appointmentId,
        amount: appointment.totalPrice,
        paymentMethod: 'VNPAY',
        transactionCode,
        status: 'PENDING',
      },
    });
    const baseUrl = this.configService.get('VNP_URL');
    const queryString = Object.keys(vnpParams)
      .map(key => `${key}=${encodeURIComponent(vnpParams[key])}`)
      .join('&');
    return `${baseUrl}?${queryString}`;
  }
}
3.2. Xử lý IPN (Instant Payment Notification)
File: src/modules/payments/payments.controller.ts
typescript
@Post('vnpay-ipn')
async handleIpn(@Req() req: Request) {
  const params = req.query;
  const secureHash = params.vnp_SecureHash;
  delete params.vnp_SecureHash;
  delete params.vnp_SecureHashType;
  // Kiểm tra chữ ký
  const sortedKeys = Object.keys(params).sort();
  const signData = sortedKeys.map(key => `${key}=${params[key]}`).join('&');
  const secretKey = this.configService.get('VNP_HASH_SECRET');
  const computedHash = crypto.createHmac('sha512', secretKey).update(signData).digest('hex');
  if (computedHash !== secureHash) {
    return { RspCode: '97', Message: 'Chữ ký không hợp lệ' };
  }
  const transactionCode = params.vnp_TxnRef;
  const responseCode = params.vnp_ResponseCode;
  // Xử lý trong transaction
  await this.prisma.$transaction(async (tx) => {
    const payment = await tx.paymentTransaction.findUnique({
      where: { transactionCode },
      include: { appointment: true },
    });
    if (!payment) return { RspCode: '01', Message: 'Giao dịch không tồn tại' };
    if (payment.status === 'PAID') return { RspCode: '02', Message: 'Giao dịch đã được xử lý' };
    if (responseCode === '00') {
      // Thành công
      await tx.paymentTransaction.update({
        where: { id: payment.id },
        data: {
          status: 'PAID',
          vnpResponseCode: responseCode,
          vnpTransactionNo: params.vnp_TransactionNo,
          paidAt: new Date(),
          callbackData: params,
        },
      });
      await tx.appointment.update({
        where: { id: payment.appointmentId },
        data: { status: 'PAID' },
      });
      await tx.appointmentStatusHistory.create({
        data: {
          appointmentId: payment.appointmentId,
          status: 'PAID',
          note: 'Thanh toán qua VNPay thành công',
        },
      });
      // Đẩy job gửi email và push
      await this.queueService.addEmailJob(payment.appointmentId, 'payment_success');
      await this.queueService.addPushJob(payment.appointmentId, 'payment_success');
    } else {
      // Thất bại
      await tx.paymentTransaction.update({
        where: { id: payment.id },
        data: {
          status: 'FAILED',
          vnpResponseCode: responseCode,
          callbackData: params,
        },
      });
    }
  });
  return { RspCode: '00', Message: 'Xác nhận thành công' };
}
