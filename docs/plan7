3.4. Xử lý hết hạn giữ chỗ
Worker xử lý background job (BullMQ)
typescript
@Processor('expire-appointments')
export class ExpireAppointmentsProcessor {
  @Process()
  async handleExpire() {
    const now = new Date();
    const expired = await this.prisma.appointment.findMany({
      where: {
        status: 'AWAITING_PAYMENT',
        expiresAt: { lt: now },
      },
      include: { slot: true },
    });
    for (const appt of expired) {
      await this.prisma.$transaction(async (tx) => {
        await tx.appointment.update({
          where: { id: appt.id },
          data: { status: 'EXPIRED' },
        });
        await tx.$executeRaw`
          UPDATE "appointment_slots"
          SET booked_count = booked_count - 1, is_available = true
          WHERE id = ${appt.slotId}
        `;
        await tx.appointmentStatusHistory.create({
          data: {
            appointmentId: appt.id,
            status: 'EXPIRED',
            note: 'Hết hạn giữ chỗ do không thanh toán',
          },
        });
      });
    }
  }
}
