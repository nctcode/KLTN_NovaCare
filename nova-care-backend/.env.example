# Application
NODE_ENV=development
APP_NAME=NovaCare
APP_PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nova_care?schema=public

# JWT
JWT_ACCESS_SECRET=novacare-access-secret-key-change-in-production
JWT_REFRESH_SECRET=novacare-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug
LOG_FILE_ENABLED=true

# Redis (sẽ dùng ở giai đoạn sau)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
