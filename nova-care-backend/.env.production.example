# ==============================================================================
# NovaCare Production Environment Configuration
# Hãy đổi các thông tin bí mật trước khi khởi chạy trên máy chủ VPS
# ==============================================================================

# Application
NODE_ENV=production
APP_NAME=NovaCare
APP_PORT=3000
APP_URL=https://api.novacare.vn

# Database (Khớp với cấu hình trong docker-compose.prod.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=novacare_secure_pass_2026
POSTGRES_DB=nova_care
DATABASE_URL=postgresql://postgres:novacare_secure_pass_2026@postgres:5432/nova_care?schema=public

# JWT Security (Tạo chuỗi ngẫu nhiên bí mật dài tối thiểu 32 ký tự)
JWT_ACCESS_SECRET=novacare_prod_jwt_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=novacare_prod_jwt_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# CORS (Chỉ định rõ domain web được phép gọi vào API)
CORS_ORIGIN=https://novacare.vn,https://app.novacare.vn,https://admin.novacare.vn

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Logging
LOG_LEVEL=warn
LOG_FILE_ENABLED=true

# Redis Cache & BullMQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Email SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=novacare.health@gmail.com
SMTP_PASS=isndogrsaipulhkm
SMTP_FROM=novacare.health@gmail.com
FRONTEND_URL=https://novacare.vn

