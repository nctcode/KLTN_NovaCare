# Existing deployment secrets remain in your secret manager/.env, never in source.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_CHAT=
OPENAI_MODEL_VISION=
OPENAI_MODEL_WHISPER=whisper-1
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
# Set true only after verifying JSON Schema support on your actual gateway/model.
SCREENING_STRICT_OUTPUTS=false
# Absolute path to a reviewed, generated corpus; absent = explicit rules-only result.
SCREENING_KNOWLEDGE_PATH=
