generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  PATIENT
  ADMIN
  HOSPITAL_ADMIN
}

enum AppointmentStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  PAID
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  EXPIRED
}

enum PaymentMethod {
  VNPAY
  CASH
  BANKING
  MOMO
  VIETQR
  CARD
}

enum NotificationType {
  BOOKING_CONFIRMED
  PAYMENT_SUCCESS
  REMINDER
  CANCELLED
  RESCHEDULED
  EXPIRED
  SYSTEM
}

enum HospitalType {
  PUBLIC
  PRIVATE
  INTERNATIONAL
}

enum PartnershipStatus {
  ACTIVE
  PAUSED
  TERMINATED
}

enum DataSource {
  MANUAL
  EXCEL
  API
}

enum EncounterStatus {
  IN_PROGRESS
  COMPLETED
  PUBLISHED
  CANCELLED
}

enum ObservationCategory {
  VITAL_SIGNS
  LAB_RESULT
  IMAGING
}

enum MatchingStatus {
  MATCHED
  PENDING
  UNMATCHED
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

enum ScheduleExceptionType {
  DAY_OFF
  BLOCK_TIME
}

enum ScheduleSource {
  INTERNAL
  HIS_API
}

enum SlotStatus {
  AVAILABLE
  FULL
  BLOCKED
  CONFLICTED
  CANCELLED
}

enum BookingType {
  ALL
  HOSPITAL
  ON_DEMAND
  ONLINE
}


// ============================================
// Core Tables
// ============================================
model User {
  id              String           @id @default(uuid())
  email           String?          @unique
  phone           String?          @unique
  passwordHash    String
  fullName        String
  role            Role             @default(PATIENT)
  isActive        Boolean          @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  resetPasswordToken     String?   @unique
  resetPasswordExpiresAt DateTime?
  otpCode                String?
  otpExpiresAt           DateTime?
  otpVerified            Boolean   @default(false)

  patientProfiles  PatientProfile[]
  appointments     Appointment[]
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  deviceTokens     DeviceToken[]
  auditLogs        AuditLog[]
  preExamSessions  PreExamSession[]
  medicalPassport  MedicalPassport?
  hospitalId       String?
  hospital         Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  deviceInfo String?
  ipAddress  String?
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceInfo])
  @@map("refresh_tokens")
}

model PatientProfile {
  id                   String    @id @default(uuid())
  patientCode          String?   @unique @map("patient_code")
  userId               String
  fullName             String
  gender               Gender?
  dateOfBirth          DateTime?
  phone                String?
  address              String?
  relation             String?
  identityNumber       String?   @unique
  healthInsurance      String?
  bhytInitialHospitalCode String?  @map("bhyt_initial_hospital_code")
  bhytValidFrom        DateTime? @map("bhyt_valid_from")
  bhytValidTo          DateTime? @map("bhyt_valid_to")
  provinceCode         String?   @map("province_code")
  districtCode         String?   @map("district_code")
  wardCode             String?   @map("ward_code")
  bloodType            String?   @map("blood_type")
  ethnicity            String?   @default("Kinh")
  nationality          String?   @default("Việt Nam")
  occupation           String?
  guardianName         String?
  familyMedicalHistory String?
  lifestyleRiskFactors String?
  currentMedications   String?
  medicalHistory       String?
  allergies            String?
  emergencyContact     String?
  emergencyPhone       String?
  isDefault            Boolean   @default(false)
  isActive             Boolean   @default(true)
  securityPin          String?   @map("security_pin")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  medicalEncounters MedicalEncounter[]
  hospitalLinks     PatientHospitalLink[]
  consents          PatientConsent[]

  @@map("patient_profiles")
}

model Appointment {
  id               String            @id @default(uuid())
  bookingCode      String            @unique
  patientProfileId String
  slotId           String
  medicalServiceId String?
  userId           String
  status           AppointmentStatus @default(PENDING)
  reason           String?
  symptoms         String?
  totalPrice       Decimal           @default(0)
  consultationFee  Decimal           @default(0)
  serviceFee       Decimal           @default(0)
  idempotencyKey   String?           @unique
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  cancelledAt      DateTime?
  completedAt      DateTime?
  reminderSentAt   DateTime?
  reminderCount    Int               @default(0)

  patientProfile   PatientProfile           @relation(fields: [patientProfileId], references: [id])
  user             User                     @relation(fields: [userId], references: [id])
  slot             AppointmentSlot          @relation("PrimaryAppointmentSlot", fields: [slotId], references: [id], onDelete: Restrict)
  medicalService   MedicalService?          @relation(fields: [medicalServiceId], references: [id])
  slotBookings     AppointmentSlotBooking[]
  statusHistory    AppointmentStatusHistory[]
  payment          PaymentTransaction?
  medicalEncounter MedicalEncounter?

  @@map("appointments")
}

model AppointmentSlot {
  id                String          @id @default(uuid())
  doctorWorkplaceId String
  date              DateTime?       @db.Date
  startTime         DateTime
  endTime           DateTime
  capacity          Int             @default(1)
  bookedCount       Int             @default(0)
  isAvailable       Boolean         @default(true)
  isActive          Boolean         @default(true)
  status            SlotStatus      @default(AVAILABLE)
  version           Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  doctorWorkplace     DoctorWorkplace          @relation(fields: [doctorWorkplaceId], references: [id])
  primaryAppointments Appointment[]            @relation("PrimaryAppointmentSlot")
  slotBookings        AppointmentSlotBooking[]

  @@unique([doctorWorkplaceId, startTime])
  @@index([doctorWorkplaceId, status])
  @@map("appointment_slots")
}

model AppointmentSlotBooking {
  id            String          @id @default(uuid())
  appointmentId String
  slotId        String
  createdAt     DateTime        @default(now())

  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  slot          AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, slotId])
  @@index([slotId])
  @@map("appointment_slot_bookings")
}

model AppointmentStatusHistory {
  id            String            @id @default(uuid())
  appointmentId String
  status        AppointmentStatus
  note          String?
  createdAt     DateTime          @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_status_histories")
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  appointmentId   String        @unique
  amount          Decimal
  paymentMethod   PaymentMethod
  transactionCode String        @unique
  status          PaymentStatus @default(PENDING)
  vnpResponseCode String?
  vnpTransactionNo String?
  callbackData    Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  content   String
  type      NotificationType
  isRead    Boolean          @default(false)
  readAt    DateTime?
  data      Json?
  channel   String?
  externalId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationLog {
  id            String    @id @default(uuid())
  appointmentId String?
  userId        String
  type          String
  channel       String
  status        String
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@map("notification_logs")
}

model DeviceToken {
  id          String   @id @default(uuid())
  userId      String
  deviceToken String   @unique
  deviceType  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

// ============================================
// Medical / Catalog Tables
// ============================================
model Hospital {
  id               String            @id @default(uuid())
  name             String            @unique
  address          String?
  city             String?
  phone            String?
  hotline          String?
  emergencyHotline String?
  description      String?
  logoUrl          String?
  coverImageUrl    String?
  images           String[]          @default([])
  website          String?
  email            String?
  operatingHours   String?
  googleMapUrl     String?
  latitude         Float?
  longitude        Float?
  establishedYear  Int?
  bedCount         Int?
  type             HospitalType      @default(PUBLIC)
  status           PartnershipStatus @default(ACTIVE)
  rating           Float             @default(0)
  reviewCount      Int               @default(0)
  hospitalCode     String?           @map("hospital_code")
  externalId       String?           @unique
  source           DataSource        @default(MANUAL)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  branches            HospitalBranch[]
  workPlaces          DoctorWorkplace[]
  services            MedicalService[]
  packages            HealthPackage[]
  hospitalSpecialties HospitalSpecialty[]
  medicalEncounters   MedicalEncounter[]
  patientLinks        PatientHospitalLink[]
  sourceConsents      PatientConsent[]        @relation("SourceHospitalConsents")
  targetConsents      PatientConsent[]        @relation("TargetHospitalConsents")
  users               User[]
  bookingConfigs      HospitalBookingConfig[]

  @@map("hospitals")
}

model HospitalBookingConfig {
  id                  String         @id @default(uuid())
  hospitalId          String
  bookingType         BookingType    @default(ALL)
  maxAdvanceDays      Int            @default(30)
  allowSaturday       Boolean        @default(true)
  allowSunday         Boolean        @default(true)
  minAdvanceMinutes   Int            @default(60)
  defaultSlotDuration Int            @default(30)
  scheduleSource      ScheduleSource @default(INTERNAL)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  hospital            Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, bookingType])
  @@index([hospitalId])
  @@map("hospital_booking_configs")
}

model HospitalBranch {
  id         String   @id @default(uuid())
  hospitalId String
  name       String?
  address    String
  phone      String?
  latitude   Float?
  longitude  Float?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  hospital   Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  workPlaces DoctorWorkplace[]

  @@map("hospital_branches")
}

model Specialty {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  icon          String?
  coverImageUrl String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workPlaces          DoctorWorkplace[]
  hospitalSpecialties HospitalSpecialty[]
  packages            HealthPackage[]
  services            MedicalService[]

  @@map("specialties")
}

model HospitalSpecialty {
  id          String    @id @default(uuid())
  hospitalId  String
  specialtyId String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hospital  Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, specialtyId])
  @@map("hospital_specialties")
}

model Doctor {
  id                String      @id @default(uuid())
  fullName          String
  title             String?
  avatarUrl         String?
  qualification     String
  yearsOfExperience Int         @default(0)
  gender            Gender?
  bio               String?
  externalId        String?     @unique
  source            DataSource  @default(MANUAL)
  rating            Float       @default(0)
  reviewCount       Int         @default(0)
  consultationCount Int         @default(0)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  workPlaces DoctorWorkplace[]

  @@map("doctors")
}

model DoctorWorkplace {
  id              String            @id @default(uuid())
  doctorId        String
  hospitalId      String
  branchId        String?
  specialtyId     String
  consultationFee Decimal           @default(0)
  position        String?
  joinedAt        DateTime?
  isPrimary       Boolean           @default(false)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch          HospitalBranch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  specialty       Specialty         @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  schedules       DoctorSchedule[]
  slots           AppointmentSlot[]
  exceptions      ScheduleException[]

  @@unique([doctorId, hospitalId, specialtyId])
  @@map("doctor_workplaces")
}

model ScheduleException {
  id                String                @id @default(uuid())
  doctorWorkplaceId String
  date              DateTime              @db.Date
  startTime         String?
  endTime           String?
  exceptionType     ScheduleExceptionType
  reason            String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  doctorWorkplace   DoctorWorkplace       @relation(fields: [doctorWorkplaceId], references: [id], onDelete: Cascade)

  @@index([doctorWorkplaceId, date])
  @@map("schedule_exceptions")
}

model MedicalService {
  id                String                  @id @default(uuid())
  hospitalId        String
  specialtyId       String?
  name              String
  description       String?
  price             Decimal                 @default(0)
  duration          Int                     @default(30)
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  hospital          Hospital                @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  specialty         Specialty?              @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  appointments      Appointment[]
  scheduleServices  DoctorScheduleService[]

  @@map("medical_services")
}

model HealthPackage {
  id                  String     @id @default(uuid())
  hospitalId          String
  specialtyId         String?
  name                String
  thumbnailUrl        String?
  price               Decimal    @default(0)
  originalPrice       Decimal?
  description         String?
  duration            Int        @default(60)
  services            Json?
  preparationNote     String?
  estimatedResultTime String?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  hospital  Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  specialty Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  @@map("health_packages")
}

model DoctorSchedule {
  id                String                  @id @default(uuid())
  doctorWorkplaceId String
  bookingType       BookingType             @default(ALL)
  dayOfWeek         Int
  startTime         String
  endTime           String
  breakStart        String?
  breakEnd          String?
  slotDuration      Int?
  capacity          Int                     @default(1)
  effectiveFrom     DateTime?               @db.Date @default(now())
  effectiveTo       DateTime?               @db.Date
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  doctorWorkplace   DoctorWorkplace         @relation(fields: [doctorWorkplaceId], references: [id], onDelete: Cascade)
  scheduleServices  DoctorScheduleService[]

  @@index([doctorWorkplaceId, dayOfWeek])
  @@map("doctor_schedules")
}

model DoctorScheduleService {
  id               String         @id @default(uuid())
  scheduleId       String
  medicalServiceId String
  createdAt        DateTime       @default(now())

  schedule         DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  medicalService   MedicalService @relation(fields: [medicalServiceId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, medicalServiceId])
  @@index([medicalServiceId])
  @@map("doctor_schedule_services")
}

// ============================================
// Phase 8 – Pre-Exam AI & Medical Passport
// ============================================

model PreExamSession {
  id              String    @id @default(uuid())
  userId          String
  status          String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, EXPIRED
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  initialText     String?
  voiceTranscript String?
  bodyDiagramData Json?
  imageAnalysis   Json?
  uploadedFiles   String[]
  structuredData  Json?
  recommendations Json?
  riskLevel       String?   // MONITOR, CONSULT, EMERGENCY
  expiresAt       DateTime

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions PreExamQuestion[]
  media     ScreeningMedia[]

  @@map("pre_exam_sessions")
}

model PreExamQuestion {
  id        String  @id @default(uuid())
  sessionId String
  question  String
  answer    String?
  order     Int
  context   Json?

  preExamSession PreExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("pre_exam_questions")
}

model ScreeningMedia {
  id               String   @id @default(uuid())
  sessionId        String
  type             String   // VIDEO_VOICE, SYMPTOM_IMAGE, MEDICAL_DOCUMENT, VOICE_AUDIO
  storageKey       String
  mimeType         String
  sizeBytes        Int
  durationMs       Int?
  scriptId         String?  @default("DEFAULT_VOICE_SAMPLE")
  processingStatus String   @default("PROCESSING") // PROCESSING, READY, ERROR
  transcript       String?
  createdAt        DateTime @default(now())

  session          PreExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("screening_media")
}

model MedicalPassport {
  id        String   @id @default(uuid())
  userId    String   @unique
  summary   Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  user   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares MedicalPassportShare[]

  @@map("medical_passports")
}

model MedicalPassportShare {
  id               String    @id @default(uuid())
  passportId       String
  shareToken       String    @unique
  qrCode           String    @unique
  pinCode          String?
  allowedSections  String[]
  validUntil       DateTime
  isActive         Boolean   @default(true)
  lastAccessedAt   DateTime?
  accessCount      Int       @default(0)
  sharedWith       String?
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  medicalPassport MedicalPassport              @relation(fields: [passportId], references: [id], onDelete: Cascade)
  accessLogs      MedicalPassportAccessLog[]

  @@map("medical_passport_shares")
}

model MedicalPassportAccessLog {
  id        String   @id @default(uuid())
  shareId   String
  ipAddress String?
  userAgent String?
  accessedAt DateTime @default(now())

  share MedicalPassportShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@map("medical_passport_access_logs")
}

// ============================================
// Phase 1 – Interoperability Clinical History Models
// ============================================

model MedicalEncounter {
  id                    String          @id @default(uuid())
  patientProfileId      String
  hospitalId            String
  appointmentId         String?         @unique
  externalEncounterId   String?
  encounterCode         String          @unique
  encounterDate         DateTime        @default(now())
  doctorName            String
  doctorTitle           String?
  specialtyName         String
  chiefComplaint        String?
  clinicalSummary       String?
  physicalExamination   String?
  organSystemsExam      Json?
  specialtyExam         Json?
  admissionSource       String?
  admissionAt           DateTime?
  dischargeType         String?
  treatmentDays         Int?            @default(1)
  initialDiagnosis      String?
  differentialDiagnosis String?
  treatmentPlan         String?
  doctorNotes           String?
  conclusion            String?
  treatmentResult       String?
  revisitDate           DateTime?
  prognosisNear         String?
  prognosisFar          String?
  careLevel             String?
  dietaryRegimen        String?
  departmentHeadName    String?
  hospitalDirectorName  String?
  digitalSignature      Json?
  status                EncounterStatus @default(PUBLISHED)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  diagnoses    Diagnosis[]
  observations Observation[]
  prescription Prescription?

  @@map("medical_encounters")
}

model Diagnosis {
  id             String   @id @default(uuid())
  encounterId    String
  icdCode        String
  diseaseName    String
  isPrimary      Boolean  @default(true)
  isComplication Boolean  @default(false)
  diagnosisType  String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  encounter MedicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("diagnoses")
}

model Observation {
  id             String              @id @default(uuid())
  encounterId    String
  category       ObservationCategory @default(VITAL_SIGNS)
  code           String?
  name           String
  value          String
  unit           String?
  referenceRange String?
  interpretation String?
  observedAt     DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  encounter MedicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("observations")
}

model Prescription {
  id               String   @id @default(uuid())
  encounterId      String   @unique
  prescriptionCode String   @unique
  prescribedAt     DateTime @default(now())
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  encounter MedicalEncounter   @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  items     PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id               String   @id @default(uuid())
  prescriptionId   String
  drugName             String
  activeIngredientCode String?  @map("active_ingredient_code")
  dosage               String
  usageInstruction String
  quantity         Int
  unit             String?
  duration         String?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

model PatientHospitalLink {
  id                String         @id @default(uuid())
  patientProfileId  String
  hospitalId        String
  externalPatientId String
  matchingStatus    MatchingStatus @default(MATCHED)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([patientProfileId, hospitalId])
  @@unique([hospitalId, externalPatientId])
  @@map("patient_hospital_links")
}

model PatientConsent {
  id               String        @id @default(uuid())
  patientProfileId String
  sourceHospitalId String
  targetHospitalId String
  status           ConsentStatus @default(GRANTED)
  grantedAt        DateTime?
  expiresAt        DateTime?
  revokedAt        DateTime?
  // The patient-selected clinical record and data categories that may be read.
  // Keeping this as JSON lets the consent remain portable when a partner HIS
  // exposes a different internal document structure.
  scope            Json?
  purpose          String          @default("TREATMENT")
  confirmedAt      DateTime?
  policyVersion    String          @default("novacare-consent-v1")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  sourceHospital Hospital       @relation("SourceHospitalConsents", fields: [sourceHospitalId], references: [id], onDelete: Cascade)
  targetHospital Hospital       @relation("TargetHospitalConsents", fields: [targetHospitalId], references: [id], onDelete: Cascade)

  @@unique([patientProfileId, sourceHospitalId, targetHospitalId])
  @@map("patient_consents")
}

