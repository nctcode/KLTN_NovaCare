generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  PAID
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  EXPIRED
}

enum PaymentMethod {
  VNPAY
  CASH
  BANKING
}

enum NotificationType {
  BOOKING_CONFIRMED
  PAYMENT_SUCCESS
  REMINDER
  CANCELLED
  RESCHEDULED
  EXPIRED
  SYSTEM
}

// ============================================
// Core Tables
// ============================================
model User {
  id              String           @id @default(uuid())
  email           String?          @unique
  phone           String?          @unique
  passwordHash    String
  fullName        String
  isActive        Boolean          @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  patientProfiles PatientProfile[]
  appointments    Appointment[]
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  deviceTokens    DeviceToken[]
  auditLogs       AuditLog[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  deviceInfo String?
  ipAddress  String?
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceInfo])
  @@map("refresh_tokens")
}

model PatientProfile {
  id               String    @id @default(uuid())
  userId           String
  fullName         String
  gender           Gender?
  dateOfBirth      DateTime?
  phone            String?
  address          String?
  relation         String?
  identityNumber   String?   @unique
  healthInsurance  String?
  medicalHistory   String?
  allergies        String?
  emergencyContact String?
  emergencyPhone   String?
  isDefault        Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("patient_profiles")
}

model Appointment {
  id               String            @id @default(uuid())
  bookingCode      String            @unique
  patientProfileId String
  slotId           String
  medicalServiceId String?
  userId           String
  status           AppointmentStatus @default(PENDING)
  reason           String?
  symptoms         String?
  totalPrice       Decimal           @default(0)
  consultationFee  Decimal           @default(0)
  serviceFee       Decimal           @default(0)
  idempotencyKey   String?           @unique
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  cancelledAt      DateTime?
  completedAt      DateTime?

  patientProfile PatientProfile           @relation(fields: [patientProfileId], references: [id])
  user           User                     @relation(fields: [userId], references: [id])
  slot           AppointmentSlot          @relation(fields: [slotId], references: [id])
  medicalService MedicalService?          @relation(fields: [medicalServiceId], references: [id])
  statusHistory  AppointmentStatusHistory[]
  payment        PaymentTransaction?

  @@map("appointments")
}

model AppointmentSlot {
  id                String  @id @default(uuid())
  doctorWorkplaceId String
  startTime         DateTime
  endTime           DateTime
  capacity          Int      @default(1)
  bookedCount       Int      @default(0)
  isAvailable       Boolean  @default(true)
  isActive          Boolean  @default(true)
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  doctorWorkplace DoctorWorkplace @relation(fields: [doctorWorkplaceId], references: [id])
  appointments    Appointment[]

  @@unique([doctorWorkplaceId, startTime])
  @@map("appointment_slots")
}

model AppointmentStatusHistory {
  id            String            @id @default(uuid())
  appointmentId String
  status        AppointmentStatus
  note          String?
  createdAt     DateTime          @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_status_histories")
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  appointmentId   String        @unique
  amount          Decimal
  paymentMethod   PaymentMethod
  transactionCode String        @unique
  status          PaymentStatus @default(PENDING)
  vnpResponseCode String?
  vnpTransactionNo String?
  callbackData    Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  content   String
  type      NotificationType
  isRead    Boolean          @default(false)
  readAt    DateTime?
  data      Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model DeviceToken {
  id          String   @id @default(uuid())
  userId      String
  deviceToken String   @unique
  deviceType  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

// ============================================
// Medical / Catalog Tables
// ============================================
model Hospital {
  id          String   @id @default(uuid())
  name        String   @unique
  address     String?
  phone       String?
  description String?
  logoUrl     String?
  website     String?
  email       String?
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  branches   HospitalBranch[]
  workPlaces DoctorWorkplace[]
  services   MedicalService[]

  @@map("hospitals")
}

model HospitalBranch {
  id         String   @id @default(uuid())
  hospitalId String
  name       String?
  address    String
  phone      String?
  latitude   Float?
  longitude  Float?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@map("hospital_branches")
}

model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workPlaces DoctorWorkplace[]

  @@map("specialties")
}

model Doctor {
  id            String   @id @default(uuid())
  fullName      String
  avatarUrl     String?
  qualification String
  experience    String?
  bio           String?
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  workPlaces DoctorWorkplace[]
  schedules  DoctorSchedule[]

  @@map("doctors")
}

model DoctorWorkplace {
  id              String   @id @default(uuid())
  doctorId        String
  hospitalId      String
  specialtyId     String
  consultationFee Decimal  @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital  Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  slots     AppointmentSlot[]

  @@unique([doctorId, hospitalId, specialtyId])
  @@map("doctor_workplaces")
}

model MedicalService {
  id          String   @id @default(uuid())
  hospitalId  String
  name        String
  description String?
  price       Decimal  @default(0)
  duration    Int      @default(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("medical_services")
}

model DoctorSchedule {
  id         String   @id @default(uuid())
  doctorId   String
  dayOfWeek  Int
  startTime  String
  endTime    String
  breakStart String?
  breakEnd   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}
